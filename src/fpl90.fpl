   %VOS_3 PROCESS  FILE '/MSEKIYA.FPLF.FORT(FPLF77L)'
   %VM    PROCESS  FILE  '/FPLF77L FTN A1'
   %MSDOS PROCESS  FILE '..\MTSFORT\FPLF77L.FOR'
   %UNIX   PROCESS  FILE 'FPL77LIB.f'
   %MTS   PROCESS  FILE 'FPL77LIB.FTN'
   %MAC   PROCESS  FILE ':NEW:fpl77lib.f'
 
   PROCESS     HEADDER IQDATE
   SUBROUTINE IQDATE ( MDATE )
   CHARACTER  CDATE * 12, MDATE * 8
   BEGIN
      /*--FOR Lahey fortran  -----/
      CALL DATE ( CDATE )
      MDATE = CDATE
      END
 
   PROCESS     HEADDER IQTIME
   SUBROUTINE IQTIME ( MTIME )
      CHARACTER CTIME * 12, MTIME * 8
   BEGIN
      /*--FOR Lahey fortran  -----/
      CALL TIME ( CTIME )
      MTIME = CTIME (1:8)
      END
 
   PROCESS   HEADDER FPLVS24 
   %VOS_3 PROCESS  FILE '/MSEKIYA.FPLF.FORT(FPLVS)'
   %VM    PROCESS  FILE '/FPLVS24  FTN A1'
   %MSDOS PROCESS  FILE '..\MTSFORT\FPLVS.FOR'
   %UNIX   PROCESS  FILE 'FPLVS.f'
   %MTS   PROCESS  FILE 'FPLVS.FTN'
   %MAC   PROCESS  FILE ':NEW:fplvs24.f'
 
   PROCESS     HEADDER IQDATE
   SUBROUTINE IQDATE ( MDATE )
      CHARACTER  MDATE * 8
      CHARACTER*4  CHAR4
      CHARACTER*12 CHAR12
      INTEGER*4    NOW(8)
      CHARACTER*3 MONTH(12)
      DATA MONTH/'JAN','FEB','MAR','APR','MAY','JUN', --
                 'JUL','AUG','SEP','OCT','NOV','DEC'/
      /*--FOR IBM VS   FORTRAN  -----/
 
   BEGIN
      CALL DATIM ( NOW )
      NOW(8) = MOD(NOW(8),100)
      FORTRAN WRITE(MDATE,'(A3,I2,A1,I2)') --
              MONTH(NOW(7)),NOW(6),' ',NOW(8)
      END
 
   PROCESS     HEADDER IQTIME
   SUBROUTINE IQTIME ( MTIME )
      CHARACTER* 8  MTIME
      CHARACTER*12 CHAR12
      INTEGER*4    NOW(8)
      /*--FOR IBM VS   FORTRAN  -----/
   BEGIN
      CALL DATIM ( NOW )
      NOW(4) = 100 + NOW(4)
      NOW(3) = 100 + NOW(3)
      FORTRAN WRITE(CHAR12,'(I4,I3,I3)')  NOW(5),NOW(4),NOW(3)
      CHAR12(5:5) = ':' ; char12(8:8) = ':' ;
      MTIME = CHAR12 (1:7)
      END
 
