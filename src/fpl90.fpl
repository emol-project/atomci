   BEGIN
      CALL CLOCK ( CTIME, 1 )
      MTIME = CTIME (1:8)
      END
 
   PROCESS    HEADDER FPLRMFT 
   %VOS_3 PROCESS  FILE '/MSEKIYA.FPLF.FORT(FPLRMFT)'
   %VM    PROCESS  FILE '/FPLRMFT FTN A1'
   %MSDOS PROCESS  FILE '..\MTSFORT\FPLRMFT.FOR'
   %UNIX   PROCESS  FILE 'FPLRMFT.f'
   %MTS   PROCESS  FILE 'FPLRMFT.FTN'
   %MAC   PROCESS  FILE ':NEW:fplrmft.f'
 
   PROCESS     HEADDER IQDATE
   SUBROUTINE IQDATE ( MDATE )
   INTEGER * 2   YY, MM, DD
   CHARACTER  MDATE * 8
   BEGIN
      CALL GETDAT ( YY, MM, DD )
      WHILE  YY > 99 THEN = YY - 100
      WRITE ( MDATE, '(I2, A, I2, A, I2)') YY,'-',MM,'-',DD
      END
 
   PROCESS     HEADDER IQTIME
   SUBROUTINE IQTIME ( MTIME )
      INTEGER * 2   HH, MM, SS, HS
      CHARACTER  MTIME*8
   BEGIN
      CALL GETTIM ( HH, MM, SS, HS )
      WRITE ( MTIME, '(I2, A, I2, A, I2)') HH,':',MM,':',SS
      END


   PROCESS    HEADDER FPLNEWS 
   %VOS_3 PROCESS  FILE '/MSEKIYA.FPLF.FORT(FPLNEWS)'
   %VM    PROCESS  FILE '/FPLNEWS FTN A1'
   %MSDOS PROCESS  FILE '..\MTSFORT\FPLNEWS.FOR'
   %UNIX   PROCESS  FILE 'fplnews.f'
   %MTS   PROCESS  FILE 'FPLNEWS.FTN'
   %MAC   PROCESS  FILE ':NEW:fplnews.f'
 
   PROCESS     HEADDER IQDATE
   SUBROUTINE IQDATE ( MDATE )
   INTEGER    iarr(3), YY
   CHARACTER  MDATE * 8
   /       intrinsic  idate
   BEGIN
      CALL idate ( iarr )
      yy = mod(iarr(3),100)
      WRITE ( MDATE, '(I2, A, I2, A, I2)') YY,'-',iarr(2),'-',iarr(1)
      END
 
   PROCESS     HEADDER IQTIME
   SUBROUTINE IQTIME ( MTIME )
      INTEGER    iarr(3) 
      CHARACTER  MTIME*8
   /       intrinsic  itime
   BEGIN
      CALL itime ( iarr )
      WRITE ( MTIME, '(I2, A, I2, A, I2)') --
                        iarr(1),':',iarr(2),':',iarr(3)
      END

