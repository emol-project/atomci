   %%SUBNAME EXTAPE%
   process    file 'extape.f'
   PROCESS    NO LIST      MAP    HEADER  %SUBNAME
      SUBROUTINE %SUBNAME                    --
               ( NFTE,   NFTCX,       --
                 NWFSG,               LRPS  ,--
                 NWTC ,               NWF   ,--
                 NWTN ,  NWTH,        NWT   ,--
                 ISSH ,               LMAX   ,--
                 NWSQ ,               L100  ,--
                 ISPIN, IORB, IPAR, ITNEL,   --
                 ITSTV, NTYPE, NREF,         --
                 NAME,  MXRPS, LWFL,  --
                 NPFLG,RULE,MCFLAG,          --
                 RTNCD)
 %UPDATE
 /*
 /*           CODED    BY M. SEKIYA  ON 1987-12-12  AT IMS
 /*           MODIFIED BY TASHI      ON 1989-10-25  AT HUCC
 /*
 /*     FUNCTION :  CREATE ENERGY EXPRESSION TAPE
 /*     CALLED   :  EXTAP1
 /*     CALLING  :  EXIJ   +----> SMAT
 /*                 removed SAS 94-01-16 WIGSET
 /*                 (QSHMS)                   ENTRY OF SHMS
 /*                 (TAFACT)                  ENTRY OF AFACT
 /*                 (STORE)                   ENTRY OF QTISQT
 /*
 /*
      IMPLICIT REAL*8(A-H,O-Z)
      %comstr
      /* DCL  EXTERNAL ENTRY
      EXTERNAL       IOR,ISP,ISPTST,      -- ISP
                     --  removed SAS   WIGSET,              -- WIGSET
                     TCFP,                -- CFP
                     LCODa,               -- LCODE
                     TSMATA,    -- SMAT   QSMAT,TSMATA,QSMATC,QSMAT2
                     QSHMSB,TSHMS,        -- SHMS
                     TAFACT,              -- AFACT
                     TCFACA,              -- CFAC
                     -- ISQTQ,ISQTP,STORE,  -- QTISQT
                     setiad,tintad,STORE,  -- QTISQT
                     NOETL                -- QTISQT



      /* DCL INPUT ARGUMENT
      INTEGER   * 2  NWFSG(LRPS)        --*W* WORK REGION FOR CSF

      INTEGER   * 4  NFTE,               --*I* OUTPUT EE TAPE
                     NFTCX,               --*I* WORK FILE ( IN EE TAPE )
                     NAME(30),           --
                     RULE,               --*I*  EXPRESSION CREATION RULE
                     RTNCD,              --
                     ERRCD


      /* DCL  LOCAL VAR
      LOGICAL     IOERR,IOEND            --*L* IO FLAG

      INTEGER   * 4                         --
                     ISSH(LMAX),             --*L* NUMBER OF ORB IN SYM
                     NWTH(NWT),             --*L* ORBITAL
                     NWSQ(L100),            --*L* ORDER OF COUPLING
                     NWTN(NWT),             --*L* SHELL SCHEME
                     NWTC(NWF),             --*L* DEFAULT CLOSED SHELL
                     -- IWAD(12),IVAD(12),     --*L* ORBITAL INDEX OF
                     -- IWVAD(130),            --*L* LEFT AND RIGHT CSF
                     N0,                    --*L* CONSTANT
                     BYT                    --*L* CONSTANT

      INTEGER   * 4  IAFACT,IISP,IISQT,     --*L* DEBUG FLAG
                     ISHMS,ICFAC,ISMAT,     --*L*    FOR EXTERNAL
                     ICFP,INTBL,ICVAL       --*L*    ENTRY

      INTEGER   * 4  USEDS,USEDMS
      data  N0/0/
      DATA  IAFACT,IISP,IISQT,ISHMS,ICFAC,ISMAT,ICFP,INTBL,ICVAL/9*0/
      DATA  BYT/256/
      DATA  IOSTAT/0/
      NAMELIST/CHECK/ --
            IAFACT,IISP,IISQT,ISHMS,ICFAC,ISMAT,ICFP,INTBL,ICVAL

   %%CHECK IF ERRCD > 0 THEN EXIT EXEC ERROR_INFORMATION ; %
   %%IOR     ENDFLAG = IOEND ERRFLAG = IOERR IOSTAT = IOSTAT %
   %%IOCHECK  IF IOERR ! IOEND THEN EXIT ERRCD = %ERRCD %

   BEGIN ;

      IWFIN=0  ; ERRCD = 0 ; IOERR = .FALSE. ; IOEND = .FALSE.
      /*  NFTA IS GENERATED BY WFNONZ OR WFEEBK
      /*  EXPRESION IS WRITTEN IN NFTE
      CALL NTISQT --
           (--
            NPFLG,MCFLAG,NFTE)

      IF NPFLG >= 3 THEN READ(5,CHECK)
      EXEC CFPSET  ; %CHECK
      NOEC=0    ;   N1OEC=0 ;  NOET=0  ;  N1OET=0
      EXEC SETUP
      IF RULE = 0 THEN DO
         EXEC WRITE_NFTE_HEAD    ; %CHECK
         JS = 1 ; JA = 0
         EXEC ENERGY_EXPRESSION  ;
         END
      ELSE IF RULE >= 1 THEN DO
         IF RULE > 1 THEN KSTV = RULE ; ELSE KSTV = -1 ;
         EXEC READ_WAVE_FUNCTION  ; %CHECK
         IF NFTE = NFTCX
         THEN EXEC FIND_END_OF_NFTE
         ELSE EXEC COPY_NFTCX_TO_NFTE
         %CHECK
         EXEC FIND_JS ; %CHECK
         / IF RULE > 1 THEN EXIT
         EXEC ENERGY_EXPRESSION  ;
         END
      IF ERRCD > 0 THEN EXIT

      EXEC PRINT_SUMMARY     ; %CHECK
      END

   PROCEDURE FIND_END_OF_NFTE
      EXEC TIME_IN ;  NRECRD = 1 ;
      DO UNTIL JSTART = KSTV ;
         BINARY READ : NFTE %IOR JSTART, KS
         NRECRD = NRECRD + 1
         IF IOEND ! IOERR  THEN EXIT
         IF KS = 0 THEN NRECRD = 2
         END
      IF IOERR THEN EXIT ERRCD = 6211
      ELSE IF KSTV > 0 & KSTV ^= JSTART THEN EXIT ERRCD = 6231
      IOEND = .FALSE. ; IOSTAT = 0
    /* BACKSPACE UNTIL KS = 0
      FOR I = 1, NRECRD ; BACKSPACE NFTE
      UNTIL KS = 0 ! IOERR ! IOEND
      DO
         BINARY READ : NFTE  %IOR JSTART , KS, NOE
         FORMAT WRITE --
         '   ISTART =>',JSTART,'   NOE =>',NOE,'   READING FROM ',NFTE
             ( 2(A,I10), A, I4  )
         END
      IF ( KS ^= 0 & NOE ^= 0 ) ! IOERR ! IOEND THEN EXIT ERRCD = 6221
      BACKSPACE NFTE
      1L ; ' > CPU TIMES FOR FIND BOTTOM ' ;
      EXEC TIME_PRINT ;
      END

   PROCEDURE COPY_NFTCX_TO_NFTE
      EXEC TIME_IN ;
      EXEC WRITE_NFTE_HEAD  ; NRECRD = 1
      DO UNTIL JSTART = KSTV
         BINARY READ : NFTCX %IOR --
            JSTART, KS,NOEX,N1OEX,N2OE,NIJ,NII,LTRI,  --
            (WT(I),I=1,NOEX),     --
            (ISQN(I),I=1,LTRI),  --
            (INDEXJ(I),I=1,NIJ), --
            (INDEXI(I),I=1,NII)
         NRECRD = NRECRD + 1
         IF IOEND ! IOERR THEN EXIT
         BINARY WRITE : NFTE  --
            JSTART, KS,NOEX,N1OEX,N2OE,NIJ,NII,LTRI,  --
            (WT(I),I=1,NOEX),     --
            (ISQN(I),I=1,LTRI),  --
            (INDEXJ(I),I=1,NIJ), --
            (INDEXI(I),I=1,NII)
         IF KS = 0  THEN NRECRD = 2
         END
      IF IOERR THEN EXIT ERRCD = 6212
      ELSE IF KSTV > 0 & KSTV ^= JSTART THEN EXIT ERRCD = 6232
      IOEND = .FALSE. ; IOSTAT = 0
    /* BACKSPACE UNTIL KS = 0
      FOR I = 1, NRECRD ; BACKSPACE NFTCX
      UNTIL KS = 0 ! IOERR ! IOEND
      DO
         BINARY READ : NFTCX  %IOR JSTART , KS, NOE
         FORMAT WRITE --
         '   ISTART =>',JSTART,'   NOE =>',NOE,'   READING FROM ',NFTCX
             ( 2(A,I10), A, I4  )
         END
      IF IOEND ! IOERR THEN EXIT ERRCD = 6222
      IF NOE ^= 0 THEN EXIT ERRCD = 6223
      ENDFILE NFTCX
      1L ;
    /* BACKSPACE TOP OF JSTART RECORDS
      FOR I = 1, NRECRD-1 ; BACKSPACE NFTE  ; /-1 --> END OF FILE RECORDS
      UNTIL KS = 0 ! IOERR ! IOEND
      DO
         BINARY READ : NFTE  %IOR JSTART , KS, NOE
         FORMAT WRITE --
         '   ISTART =>',JSTART,'   NOE =>',NOE,'   READING FROM ',NFTE
             ( 2(A,I10), A, I4  )
         END
      IF  IOERR ! IOEND THEN EXIT ERRCD = 6232
      IF ( KS ^= 0 & NOE ^= 0 ) THEN EXIT ERRCD = 6233
      BACKSPACE NFTE
      1L ; ' > USED CPU TIMES FOR COPY   ' ;
      EXEC TIME_PRINT ;
      END

   PROCEDURE FIND_JS
      /* FIND JS
      JS = 1 ; JA = 0
      IF JSTART = 0 THEN EXIT
      UNTIL  JA >= JSTART
      DO ;
         NSJ   =NWFSG(JS)   ; /* NUMBER OF SHELLS
         NJRPS =NWFSG(JS+1) ; /* NUMBER OF SAME TYPE CONFIGURATION
         JS  = JS + NSJ * ( NJRPS + 3 ) + 2
         JA  = JA + NJRPS
         END
      FORMAT WRITE JA,JS
      (//'  > RESTART < JA => ',I8,'   JS => ',I10 // )
      IF JA ^= JSTART THEN ERRCD = 6399
      END

   PROCEDURE READ_WAVE_FUNCTION
      /* COPY WAVE FUNCTION
      IMIN = 1 ;
      DO UNTIL IMAX >= INT
         IMAX = MIN0(IMIN + LWFL - 1 , INT )
         KT   =  IMAX - IMIN + 1 ;
         BINARY READ : NFTCX ERRFLAG = IOERR ENDFLAG = IOEND --
            KT,(NWFSG(I),I=IMIN,IMAX)
         IMIN = IMAX + 1
         IF IOERR ! IOEND THEN EXIT ERRCD = 6301
         END
      END

   PROCEDURE WRITE_NFTE_HEAD
      REWIND NFTE
      BINARY WRITE : NFTE ERRFLAG = IOERR --
             NAME,ISPIN,IORB,IPAR,NWT,NWF,ITSTV,ITNEL,LIJB,--
             IDIAG,LMAX,INT,LWFL,NTYPE,NREF,  MXRPS
      IF IOERR THEN EXIT ERRCD = 6201
      BINARY WRITE : NFTE ERRFLAG = IOERR --
             (ISSH(I),I=1,LMAX),(NWTN(I),I=1,NWT), --
             (NWTC(I),I=1,NWF), (NWSQ(I),I=1,NWT)
   /*KGN 07/90 CHANGE NWSQ

      IF IOERR THEN EXIT ERRCD = 6202

      /* COPY WAVE FUNCTION
      IMIN = 1 ;
      DO UNTIL IMAX >= INT
         IMAX = MIN0(IMIN + LWFL - 1 , INT )
         KT   =  IMAX - IMIN + 1 ;
         BINARY WRITE:NFTE ERRFLAG = IOERR KT,(NWFSG(I),I=IMIN,IMAX)
         IMIN = IMAX + 1
         IF IOERR THEN EXIT ERRCD = 6203
         END
      END

   PROCEDURE SETUP
      IF NPFLG > 2 THEN --
      EXEC PRINT_HEAD
      INT = LRPS ;  IDIAG = 1
      WMUL=1.0D0/DSQRT(DFLOAT(ISPIN*IORB))
      CALL QSHMSB(WMUL)
      J=1
      FOR I=1,NWT
      DO
         LF=MOD(NWTN(I),BYT)
         NWTH(I)=LSQN(LF,LF+1,1)*BYT
/        split out of the original
/        "J <= NWF & NWTC(J) <= I" single test below -- FPL's `&` is a
/        plain .AND., which does not short-circuit, so once J ran past
/        NWF the old combined test still evaluated NWTC(J) one index
/        past its declared bound (the read's value was always discarded,
/        since J<=NWF was already false, but -fcheck=bounds still flags
/        the read). This split guarantees J<=NWF before NWTC(J) is ever
/        touched.
         DO WHILE ( J <= NWF )
            IF NWTC(J) > I THEN EXIT
            IF NWTC(J) = I THEN EXIT NWTH(I) = NWTH(I) + 2*LF
            J = J + 1 ;
            END ;
         END ;
 /    CALL   QSMAT(NWF,NWTH,NWTC,NFTCX,IWAD,IVAD,IWVAD)
      call setiad(NWT,NWTH,ISSH,INTBL,NWSQ,  LMAX)
      IF NPFLG > 2  THEN --
      FORMAT WRITE (ISSH(I),I=1,LMAX) ; ('0ISSH  =',15I7/(/8X,15I7))
      /* IDIAG=1
      call tintad(IISQT)      ;   J=ISPTST(IISP)
      CALL TAFACT(IAFACT) ;   CALL TCFACA(ICFAC)
      CALL TSMATA(ISMAT)
      CALL TSHMS(ISHMS)
      AX=TCFP(ICFP)
      END

  PROCEDURE PRINT_SUMMARY
  /* ACTUALY USED CORE AND CALCULATION WAS CHECKED
  /   CALL QSHMSC(ICADR)
  /*

      FORMAT WRITE        ITSTV,NTYPE,INT*2/1000
  (////'      GENERATED CSF                        : ',I8/--
       '      NUMBER OF CSF TYPE                   : ',I8/--
       '      USING READ BUFFER FOR WAVE FUNCTIONS : ',I8,' K BYTE'/)


      FORMAT WRITE   NOET,NOEC,N1OET,N1OEC
       (/ '    ENERGY EXPRESSION         SUMMARY:',               --
        //'   COEFFICIENTS ( TOTAL )       ', I8,',      CALC',I8,--
        / '   COEFFICIENTS ( ONE ELECTRON )', I8,',      CALC',I8 )
      CALL NOETL
      END

  > ERROR SAME CONFIG
      2L ; ERRCD = 6210
      1L ; ' ==== ERROR STOP IN %SUBNAME ========== RETURN CODE IS ' ;
      PUT ERRCD I5 ;
      FORMAT WRITE IA,JA
      ( '0VECTORS  ',I5,' AND',I5,  --
        ' ARE IDENTICAL.      ********   ERROR   ********')
      2L; ' == PLEASE CHECK YOUR INPUT DATA == ' ; 1L ;
      CALL ERSTOP('%SUBNAME')
      END

  > PRINT_HEAD

      FORMAT  WRITE NAME,NWT,NWF,ISPIN,IORB,IPAR,ITNEL
       ('0NAME  =',2X,30A4/'0NWT   =',I7,7X,'NWF   =',I7/  --
        '0SPIN  =',I7,7X,'ORB   =',I7,7X,'PAR   =',I7,7X,'TNEL  =',I7)
      FORMAT WRITE (NWTN(I),I=1,NWT)
       ('0NWTN  =',4(1X,Z4,1X,Z4,1X,Z4,1X,Z4,1X,Z4,3X)/    --
        (8X,4(1X,Z4,1X,Z4,1X,Z4,1X,Z4,1X,Z4,3X)))
      FORMAT WRITE (NWTC(I),I=1,NWF)
        ('0NWTC  =',4(1X,Z4,1X,Z4,1X,Z4,1X,Z4,1X,Z4,3X))
      FORMAT WRITE  IISP,IISQT,ISHMS,ICFAC,ISMAT,ICFP,IAFACT,INTBL, --
                    ICVAL   ,IWFIN
       ('0IISP  =',I7,7X,'IISQT =',I7,7X,'ISHMS =',I7,7X,'ICFAC =', --
        I7,7X,'ISMAT =',I7,7X,'ICFP  =',I7,7X//                     --
        ' IAFACT=',I7,7X,'INTBL =',I7,7X,'ICVAL =',I7,7X,'IWFIN =',I7)
      END ;


   PROCEDURE CFPSET
 /    J=LSQNQ(ILSTAD,ICONNT,ILFUNC)
 /    AX=QCFP(ICONNT,ILFUNC,CMTTBL,ICMTDX)
 /    CALL QSMAT2(ICONNT,LTRI)
 /    CALL WIGSET
      END

 > ENERGY_EXPRESSION
      EXEC TIME_IN ;
      UNTIL  JS >= INT ;
      DO ;
         NSJ   =NWFSG(JS)   ; /* NUMBER OF SHELLS
         NJRPS =NWFSG(JS+1) ; /* NUMBER OF SAME TYPE CONFIGURATION
         IA = JA ; II = JS
         BINARY WRITE : NFTE JA,N0,N0,N0,N0,N0,N0,N0
         UNTIL ( II >= INT ) ;
         DO ;
            NSI=NWFSG(II)
            NIRPS=NWFSG(II+1)

            CALL EXIJ ( JA, JS, IA, II, NWFSG, --
                    NOET,   N1OET,    NOEC,     N1OEC, NPFLG, ERRCD, --
                    nwt,NWF,NWTH,NWTC )
                    /   ICONNT,icnn)
            IF ERRCD > 0 THEN EXEC ERROR SAME CONFIG

            IA = IA + NIRPS
            II = II + NSI*(NIRPS+3) + 2
            END ;
         JS  = JS + NSJ * ( NJRPS + 3 ) + 2
         JA  = JA + NJRPS
         IF NPFLG >= 1 THEN DO
            CALL CLOCKM(ITOUT2) ;
            ITIN2 = ITOUT2 - ITIN2
            FORMAT WRITE:6  '   ITSTV =>',JA,'   NOEC =>',NOEC, --
            '   NJRPS =>',NJRPS,ITIN2,' M SEC '
             ( 2(A,I10),2X,A,I4,I10,A )
            ITIN2 = ITOUT2
            END
         END
      BINARY WRITE : NFTE JA,N0,N0,N0,N0,N0,N0,N0
      ENDFILE NFTE
      1L ; ' > EXPRESSION USED CPU TIMES ' ;
      EXEC TIME_PRINT
      END


   PROCEDURE TIME_PRINT
      CALL CLOCKM(ITOUT)
      USEDS = (ITOUT - ITIN)/1000
      USEDMS= MOD((ITOUT-ITIN),1000)
      PUT USEDS I4 ; ' SEC ' ; PUT USEDMS I4 ; ' M SEC ' ; 2L
      END

   PROCEDURE TIME_IN
      CALL CLOCKM(ITIN) ; 1L ; ITIN2 = ITIN
      END
   %EXERINF
