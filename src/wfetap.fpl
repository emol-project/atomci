   process file    'wfetap.f'
   %%SUBNAME WFETAP%
   PROCESS    NO LIST      MAP    HEADER  %SUBNAME
      SUBROUTINE %SUBNAME                    --
               ( NWFSG, LRPS,  MXLBUF,       --
                 NFWFA, NFWFB, NFWFE, NFWFW, --
                 LWFL,  --
                 NAMEC,NPFLG,RULE,NREF0,     --
                 MCFLAG,                     -- input 
                 ERRCD)
 %UPDATE
 %param
 /*
 /            CODED    BY M. SEKIYA  ON 1987-12-12  AT IMS
 /            CHANGED  BY TASHI      ON 1989-10-24  AT TASHI
 /*
 /*     FUNCTION :  SELECTED ONLY NON ZERO MATRIX ELEMENTS WITH
 /*                 REFERENCE CSF
 /*     CALLED   :  WFMAIN
 /*     CALLING  :  SMAT -+---> SHMS
 /*                 BKEECP
 /*                  removed   SAS 94-01-16  WIGSET
 /*                 (QSMAT)                   ENTRY OF SMAT
 /*                 (QSHMS)                   ENTRY OF SHMS
 /*                 (TAFACT)                  ENTRY OF AFACT
 /*                 (STORE)                   ENTRY OF NTISQT
 /*
 /*
      IMPLICIT REAL*8(A-H,O-Z)
      /* DCL  EXTERNAL ENTRY
      EXTERNAL       IOR,ISP,ISPTST,      -- ISP
                       --     SAS  94-01-16 WIGSET,              -- WIGSET
                     TCFP,                -- CFP
                     LCODa,               -- LCODE
                     SMAT,TSMATA, -- SHMS  QSMAT,QSMATC,QSMAT2, rem.
                     QSHMSB,TSHMS,        -- SHMS
                     TAFACT,              -- AFACT
                     TCFACA,              -- CFAC
                     -- ISQTQ,ISQTP,STORE,  -- QTISQT
                     setiad,tintad,STORE,  -- QTISQT
                     NOETL;/                NTISQT
      character * 1  lcoda

 %%DEBUG / %

      /* DCL INPUT ARGUMENT
      INTEGER   * 2  NWFSG(LRPS)        --*W* WORK REGION FOR CSF

      INTEGER   * 4  --
                     NFWFA,               --*I* INPUT CSF FROM NSTGEN
                     NFWFB,               --*I* OUTPUT CSF
                     NFWFE,               --*I* OUTPUT EE TAPE
                     NFWFW,               --*I* WORK FILE ( IN EE TAPE )
                     LRPS,               --*I* REGION SIZE
                     NAMEC(30),          --*I* COMMENT ON NFWFE
                     -- moved to common/comcfp/
                     --     SAS 94-01-16
                     RULE,               --*I*  EXPRESSION CREATION RULE
                     MCFLAG,             --*I*  EXPRESSION CREATION RULE
                     ERRCD



      /* DCL  LOCAL VAR
      LOGICAL     IOERR,IOEND            --*L* IO FLAG

  /*KGN 07/90  CHANGE BASIS SIZE
      INTEGER   * 4                         --
                     NAME(18),              --*L* READ BUFFER
                     NAMEB(30),             --*L* READ BUFFER CSF
                     ISSH(20),              --*L* NUMBER OF ORB IN SYM
                     NWTH(%BASIS),             --*L* ORBITAL
                     NWSQ(%BASIS),             --*L* ORDER OF COUPLING
                     NWTN(%BASIS),             --*L* SHELL SCHEME
                     NWTC(20),              --*L* DEFAULT CLOSED SHELL
      --              IWAD(12),IVAD(12),     --*L* ORBITAL INDEX OF
      --              IWVAD(130),            --*L* LEFT AND RIGHT CSF
      --             BYT/256/,              TASHI
                     BYT,                   --    CHANGE KGN
                     IREP(%BASIS),ISHREP(%BASIS);/ *L* PRINCIPAL Q.N.

      character*1    LREP(%BASIS),LSHREP(%BASIS);/  *L* ANGULAR  Q.N.
	
      %COMEXP
      %comstr

      INTEGER   * 4  IAFACT,IISP,IISQT,     --*L* DEBUG FLAG
                     ISHMS,ICFAC,ISMAT,     --*L*    FOR EXTERNAL
                     ICFP,INTBL,ICVAL       --*L*    ENTRY

      INTEGER   * 4  USEDS,USEDMS
      DATA  IAFACT,IISP,IISQT,ISHMS,ICFAC,ISMAT,ICFP,INTBL,ICVAL/9*0/
      DATA  BYT/256/
      data               N0/0/

      NAMELIST/CHECK/ --
            IAFACT,IISP,IISQT,ISHMS,ICFAC,ISMAT,ICFP,INTBL,ICVAL

   %%CHECK IF ERRCD > 0 THEN EXIT EXEC ERROR_INFORMATION ; %
   %%IOR   ERRFLAG = IOERR ENDFLAG = IOEND IOSTAT = IOSTAT %
   %%IOW   ERRFLAG = IOERR IOSTAT = IOSTAT %
   %%IOCHECK IF IOERR ! IOEND THEN EXIT ERRCD = %ERRCD %


   BEGIN ;
      IWFIN=0  ; ERRCD = 0 ;
      IOERR = .FALSE. ; IOEND = .FALSE. ; IOSTAT = 0
      /*  NFWFE IS GENERATED BY OSTGEN
      /*  CSF WITH NONZERO MATRIX ELEMENTS WAS COPIED FROM NFWFE TO NFWFB
      /*  EXPRESION IS WRITTEN IN NFWFW

      CALL NTISQT (NPFLG,MCFLAG,NFWFW)

      IF NPFLG >= 3 THEN READ(5,CHECK)
      EXEC CFPSET  ; %CHECK
      NOEC=0    ;   N1OEC=0 ;  NOET=0  ;  N1OET=0
      EXEC READ_WAVE_FUNCTION_HEAD ; %CHECK

      EXEC READ_REFERENCE_WAVE_FUNCTION ; %CHECK

      EXEC SETUP
      EXEC REFERENCE_ENERGY_EXPRESSION  ; %CHECK

      EXEC OUTER_VS_REFERENCE_EE   ; %CHECK
      /* COPY NFWFW TO NFWFE
      EXEC COPY_NFWFW_TO_NFWFE ; %CHECK
      EXEC OUTER_EE          ; %CHECK
      EXEC PRINT_SUMMARY     ; %CHECK
      EXIT
      FORTRAN 999 CONTINUE ; /* IO ERROR */
      1L ; ' ** ERROR OCCURRED IN READING NFWFB ( CSF FILE ) '
      PUT NFWFA I4 ; 1L ;
      ERRCD = 2100
      %CHECK
      END

   PROCEDURE SETUP
      REWIND NFWFW
      /* IDIAG=1
      call tintad(IISQT)      ;   J=ISPTST(IISP)
      CALL TAFACT(IAFACT) ;   CALL TCFACA(ICFAC)
      CALL TSMATA(ISMAT)
      CALL TSHMS(ISHMS)
      AX=TCFP(ICFP)
      END
  PROCEDURE PRINT_SUMMARY
  /* ACTUALY USED CORE AND CALCULATION WAS CHECKED
  /   CALL QSHMSC(ICADR)
  /*

      FORMAT WRITE        ITSTV,NTYPE,INT*2/1000+1
       (////'      GENERATED CSF                        : ', I8/--
       '      NUMBER OF CSF TYPE                   : ',I8/--
       '      USING READ BUFFER FOR WAVE FUNCTIONS : ',I8,' K BYTE'/)


      FORMAT WRITE  NOET,NOEC,N1OET,N1OEC
       (/ '    ENERGY EXPRESSION      SUMMARY:',                  --
        / '   COEFFICIENTS ( TOTAL )       ', I8,',      CALC',I8,--
        / '   COEFFICIENTS ( ONE ELECTRON )', I8,',      CALC',I8 )
      CALL NOETL
      END

 > REFERENCE_ENERGY_EXPRESSION
      EXEC TIME_IN
      JA=0  ; JJ = 1 ; JT = 1 ; IT = 1 ;
      JTR = 1 ; ITR=1 ;
      FORTRAN WRITE (NFWFW) JA,N0, N0,N0,N0,N0,N0,N0
      UNTIL ( JA >= NREF ) ;
      DO ;

         NSJ   =NWFSG(JJ)   ; /* NUMBER OF SHELLS
         NJRPS =NWFSG(JJ+1) ; /* NUMBER OF SAME TYPE CONFIGURATION
         JNEN  =JJ+2        ; /* ADDR FOR SHELL ID
         JNEQ  =JNEN+NSJ    ; /* ADDR FOR OCCUPATION NUMBER
         JNESL =JNEQ+NSJ    ; /* ADDR FOR SHELL COUPLING
         IF NJRPS ^=1 THEN EXIT ERRCD = 2112
         ITOT = NSJ*( 3 + NJRPS ) + 2
         FORTRAN WRITE(NFWFB)  --
         ITOT,( NWFSG(IK), IK = JJ, JJ + ITOT -1 )
         II=JJ
         IA=JA
         UNTIL ( IA >= NREF ) ! ERRCD > 0
         DO ;
            NSI=NWFSG(II)
            NIRPS=NWFSG(II+1)
            INEN=II+2
            INEQ=INEN+NSI
            INESL=INEQ+NSI
            EXEC CALC_REFERENCE EXPRESSION
            IA = IA + NIRPS
            II = INESL + NSI*(1+NIRPS)
            END ;
         JA = JA + NJRPS
         JJ = JNESL + NSJ*(1+NJRPS)
         IF NPFLG >= 1 THEN DO
            FORMAT WRITE   JA,NOEC,N1OEC
            (6X,'REF CSF=',I6,'    NOEC=',I8,'    N1OEC=',I8)
            END
         END ;
      FORTRAN WRITE (NFWFW) JA,N0, N0,N0,N0,N0,N0,N0
      EXEC TIME_PRINT

      END ;
  > CALC_REFERENCE_EXPRESSION ; /* CASE OF IDIAG = 0
    IKRPS=INESL+NSI*ITR  ; /* TYPE ADDR ( ORBITAL ID )
    JKRPS=JNESL+NSJ*JTR
    CALL SMAT --
       (NSI,NWFSG(INEN),NWFSG(INEQ),NWFSG(INESL),NWFSG(IKRPS),--
        NSJ,NWFSG(JNEN),NWFSG(JNEQ),NWFSG(JNESL),NWFSG(JKRPS),--
        NOE,N1OE,NHT,NFS,NHDT,NSIT,NSJT,--
               nwt,NWF,NWTH,NWTC)
               /  ICONNT,icnn)

    IF  NOE = 0 THEN EXIT
    CALL STORE(NOE,N1OE,IA+IT,JA+JT)
    CALL STOREH(NOE,ERRCD)
    NOET=NOET+NOE
    N1OET=N1OET+N1OE
    NOEC=NOEC+NOE
    N1OEC=N1OEC+N1OE
    END
 > OUTER_VS_REFERENCE_EE   ;
   /*  MXJRPS = MAX SIZE OF NJRPS
      MXRPS = 1
   /* J IS OUTER I IS REFERENCE
      INT = INTREF
      IF INT+1 ^= JJ THEN EXIT ERRCD = 2215
      JA=NREF ; /* JJ IS ALREADY DEFFEINED
      ITSTV = NREF ; NTYPE = NREF ;
      JTR = 1 ; ITR=1 ; IOERR = .FALSE.
      FORTRAN READ(NFWFA,ERR=999,END=100) --
                 ITOT,(NWFSG(I+INT),I=1,ITOT)
      DO WHILE ITOT > 0  & LRPS > INT + MXLBUF & ERRCD = 0
         /*   READ WAVE FUNCTION OUTER
         JS    = INT + 1 ;
         NSJ   =NWFSG(JS)   ; /* NUMBER OF SHELLS
         NJRPS =NWFSG(JS+1) ; /* NUMBER OF SAME TYPE CONFIGURATION
         JNEN  =JS+2        ; /* ADDR FOR SHELL ID
         JNEQ  =JNEN+NSJ    ; /* ADDR FOR OCCUPATION NUMBER
         JNESL =JNEQ+NSJ    ; /* ADDR FOR SHELL COUPLING
         II=1  ; IA = 0 ; IFLAG = 0 ;
         UNTIL ( IA >= NREF ) ;
         DO ;
            NSI=NWFSG(II)
            NIRPS=NWFSG(II+1)
            INEN=II+2
            INEQ=INEN+NSI
            INESL=INEQ+NSI
            EXEC CALC EXPRESSION
            IA = IA + NIRPS
            II = INESL + NSI*(1+NIRPS)
            END ;
         IF IFLAG > 0
         THEN DO
            FORTRAN WRITE(NFWFB)  --
            ITOT,( NWFSG(IK), IK = JS, JS + ITOT -1 )
            IF NJRPS > MXRPS THEN MXRPS = NJRPS
            IF NPFLG > 0 THEN EXEC PRINT_CSF
            INT = INT + ITOT
            ITSTV = ITSTV + NJRPS
            NTYPE = NTYPE + 1
            JA = JA + NJRPS
            END
         FORTRAN READ(NFWFA,ERR=999,END=100) --
                 ITOT,(NWFSG(I+INT),I=1,ITOT)
         END ;
      IF ITOT > 0 THEN EXIT ERRCD = 2211
      INTMAX = INT
      IF NPFLG > 2 THEN DO
          '  END OF FILE ' ; PUT NFWFA I4
          2L ;          '  ITSTV,NTYPE,INT > ' ;
          PUT ITSTV I8 ;   PUT NTYPE I8 ;  PUT INT   I8 ; 2L
          END
      BINARY WRITE : NFWFB N0,N0,N0
      BINARY WRITE : NFWFB MXRPS
      FORTRAN ENDFILE NFWFB
      FORTRAN ENDFILE NFWFW
      REWIND NFWFB ;
      REWIND NFWFA ;
      REWIND NFWFW ;
      EXIT
      FORTRAN 100 CONTINUE ; /* END OF FILE NFWFA
      ' == END OF FILE DETECTED == ' ; PUT NFWFA I4
      ERRCD = 2212
      END ;
  > CALC EXPRESSION
    IKRPS=INESL+NSI*ITR  ; /* TYPE ADDR ( ORBITAL ID )
    JKRPS=JNESL+NSJ*JTR
    CALL SMAT --
       (NSI,NWFSG(INEN),NWFSG(INEQ),NWFSG(INESL),NWFSG(IKRPS),--
        NSJ,NWFSG(JNEN),NWFSG(JNEQ),NWFSG(JNESL),NWFSG(JKRPS),--
        NOE,N1OE,NHT,NFS,NHDT,NSIT,NSJT,--
               nwt,NWF,NWTH,NWTC)
               /    ICONNT,icnn)
    IF  NOE = 0 THEN EXIT
    EXEC STORE_EXPRESSION
    IF  NHDT = 0 THEN EXIT --
        (JA = JA + 1 ; IA = IA + 1 ;  EXEC ERROR SAME CONFIG )
    NOEC=NOEC+NOE
    N1OEC=N1OEC+N1OE
    END
  > STORE_EXPRESSION
      IFLAG = 1 ;
      JT = 1 ; ICONF = ITSTV
      WHILE JT <= NJRPS ;
      DO ;
         ICONF = ICONF + 1 ;
         JADT=JNESL+JT*NSJ-1
         FOR IWT=1,NSJT ;
         ( KT = IVAD(IWT) ; IWVAD (KT) = NWFSG(IWT+JADT) )
         CALL STORE(NOE,N1OE,ICONF,IA+1)
         NOET=NOET+NOE
         N1OET=N1OET+N1OE
         JT = JT + 1 ;
         END ;
      CALL STOREH(NOE,ERRCD)
      END

  > DEBUG_PRINT_1
      FORMAT WRITE:6 IWAD,IVAD,IWVAD,NSI,NSIT,NSJ,NSJT, --
                    NOE, N1OE,  IA, JA, ITR, JTR
      ( ' IWAD =',12I5/' IVAD =',12I5,/'  IWVAD=',20I5/         --
        4(7X,20I5/),7X,20I5/7X,10I5/'   NSI =',I5,'  NSIT =',I5,--
        '     NSJ =',I5,'  NSJT =',I5/,                       --
        '  NOE =',I5,'  N1OE =',I5,'  IA =',I7,'  JA =',I7,    --
        '   ITR =',I5,'  JTR =', I5)
      END
   PROCEDURE COPY_NFWFW_TO_NFWFE
         IDIAG = 1 ;
    /* chang for rule = 3
      //  NOREF = NREF;
      //  NOREF = NREFX;
         BINARY WRITE : NFWFE %IOW --
                NAMEC,ISPIN,IORB,IPAR,NWT,NWF,ITSTV,ITNEL,LIJB,--
                IDIAG,LMAX,INTMAX,LWFL,NTYPE, NOREF, MXRPS
      /* IDIAG,LMAX,INTMAX,LWFL,NTYPE, NREF, MXRPS for rule 3 */
         %%ERRCD 2321 % ; %IOCHECK
   /*KGN  07/90 CHANGE LENGTH OF NWSQ
         BINARY WRITE : NFWFE %IOW --
                (ISSH(I),I=1,LMAX),(NWTN(I),I=1,NWT), --
                (NWTC(I),I=1,NWF), (NWSQ(I),I=1,NWT)
         %%ERRCD 2322 % ; %IOCHECK

         /* COPY WAVE FUNCTION
         IMIN = 1 ;
         UNTIL IMAX = INTMAX
         DO
            IMAX = MIN0(IMIN + LWFL - 1 , INTMAX )
            KT   =  IMAX - IMIN + 1 ;
            BINARY WRITE : NFWFE KT,(NWFSG(I),I=IMIN,IMAX)
            IMIN = IMAX + 1
            END

         /* COPY EE TAPE FROM NFWFW
         IOEND = .FALSE. ;        IOERR = .FALSE.
         UNTIL IOEND ! ERRCD > 0
         DO
            BINARY READ : NFWFW %IOR --
                   ITW, JTW, NOE, N1OE, N2OE, NIJ, NII, LTRI, --
                   ( WT(I),I=1,NOE ), --
                   ( ISQN(I),I=1,LTRI), --
                   ( INDEXJ(I),I=1,NIJ), --
                   ( INDEXI(I),I=1,NII)
            /      ITW, JTW, NOE, N1OE, N2OE, ISTORE
            IF       IOEND THEN EXIT
            ELSE IF  IOERR THEN EXIT ERRCD = 2325
            BINARY WRITE : NFWFE %IOW --
                   ITW, JTW, NOE, N1OE, N2OE, NIJ, NII, LTRI, --
                   ( WT(I),I=1,NOE ), --
                   ( ISQN(I),I=1,LTRI), --
                   ( INDEXJ(I),I=1,NIJ), --
                   ( INDEXI(I),I=1,NII)
            %%ERRCD 2323 % ; %IOCHECK
            END
         REWIND NFWFW
         END
      PROCEDURE CFPSET
  /      J=LSQNQ(ILSTAD,ICONNT,ILFUNC)
  /      AX=QCFP(ICONNT,ILFUNC,CMTTBL,ICMTDX)
      /  CALL QSMAT2(ICONNT,LTRI)
   /     CALL WIGSET
         END

   PROCEDURE OUTER_EE
      CALL NTISQT  (NPFLG,MCFLAG,NFWFE)
      /    (WT,ISQN,KMT,I1T,I2T,I3T,I4T,LIJB,--
      /     INDEXI,INDEXJ,NIJX,NPFLG,MCFLAG,LTRIX,NFWFE)
      DO CASE OF RULE
       1: EXEC SD_EXPRESSION
       2: EXEC OUTER_DIAG_EXPRESSION
       3: EXEC OUTER_DIAG_EXPRESSION
      99: EXEC OUTER_DIAG_BLOCK_EXPRESSION
       OTHERWISE --
        (2L; ' ** RULE '; PUT RULE I4 ; ' IS NOT YET IMPLIMENTED ';2L)
       FORTRAN ENDFILE NFWFE
       REWIND NFWFE
       END
 > OUTER_DIAG_BLOCK_EXPRESSION  ; /* J IS OUTER I IS REFERENCE
      EXEC TIME_IN
      INT = INTREF
      JA=NREF ; /* JJ IS ALREADY DEFFEINED
      IOERR = .FALSE.
      UNTIL  INT >= INTMAX ;
      DO ;
         JS    = INT + 1 ;
         NSJ   =NWFSG(JS)   ; /* NUMBER OF SHELLS
         NJRPS =NWFSG(JS+1) ; /* NUMBER OF SAME TYPE CONFIGURATION

         CALL EXIJ ( JA, JS,  JA, JS,  NWFSG,  --
                 NOET,   N1OET,    NOEC,     N1OEC, NPFLG, ERRCD , --
                 nwt,NWF,NWTH,NWTC )
         IF ERRCD > 0 THEN EXEC ERROR_INFORMATION
         INT = INT + NSJ * ( NJRPS + 3 ) + 2
         JA  = JA + NJRPS
         END
      EXEC TIME_PRINT
      END
 > SD_EXPRESSION
      EXEC TIME_IN
      JS = INTREF + 1
      JA=NREF ;
      IOERR = .FALSE.
      UNTIL  JS >= INTMAX ;
      DO ;
         NSJ   =NWFSG(JS)   ; /* NUMBER OF SHELLS
         NJRPS =NWFSG(JS+1) ; /* NUMBER OF SAME TYPE CONFIGURATION
         IA = JA ; II = JS
         BINARY WRITE : NFWFE JA,N0,N0,N0,N0,N0,N0,N0
         UNTIL ( II >= INTMAX ) ! ERRCD > 0
         DO ;
            NSI=NWFSG(II)
            NIRPS=NWFSG(II+1)

            CALL EXIJ ( JA, JS,  IA, II,  NWFSG,  --
                 NOET,   N1OET,    NOEC,     N1OEC, NPFLG, ERRCD, --
                 nwt,NWF,NWTH,NWTC )
            IF ERRCD > 0 THEN EXIT EXEC ERROR_INFORMATION

            IA = IA + NIRPS
            II = II + NSI*(NIRPS+3) + 2
            END ;
         IF NPFLG >= 1 THEN DO
            CALL CLOCKM(ITOUT2) ; ITIN2 = ITOUT2 - ITIN2
            FORMAT WRITE '   ITSTV =>',JA,'   NOEC =>',NOEC, --
                         '   NJRPS =>',NJRPS,ITIN2,' M SEC '
             ( 2(A,I10),2X,A,I4,I10,A )
             ITIN2 = ITOUT2
            END
         JS  = JS + NSJ * ( NJRPS + 3 ) + 2
         JA  = JA + NJRPS
         END
      BINARY WRITE : NFWFE JA,N0,N0,N0,N0,N0,N0,N0
      EXEC TIME_PRINT
      END

 > OUTER_DIAG_EXPRESSION  ; /* J IS OUTER I IS REFERENCE
      EXEC TIME_IN
      INT = INTREF
      JA=NREF ; /* JJ IS ALREADY DEFFEINED
      IOERR = .FALSE. ; JTR = 1
      UNTIL  INT >= INTMAX  ! ERRCD > 0
      DO ;
         JS    = INT + 1 ;
         NSJ   =NWFSG(JS)   ; /* NUMBER OF SHELLS
         NJRPS =NWFSG(JS+1) ; /* NUMBER OF SAME TYPE CONFIGURATION
         JNEN  =JS+2        ; /* ADDR FOR SHELL ID
         JNEQ  =JNEN+NSJ    ; /* ADDR FOR OCCUPATION NUMBER
         JNESL =JNEQ+NSJ    ; /* ADDR FOR SHELL COUPLING
         EXEC OUTER_DIAG_II

         INT = INT + NSJ * ( NJRPS + 3 ) + 2
         JA  = JA + NJRPS
         END
      EXEC TIME_PRINT
      END


  > OUTER_DIAG_II
      JKRPS=JNESL+NSJ*JTR
      CALL SMAT --
       (NSJ,NWFSG(JNEN),NWFSG(JNEQ),NWFSG(JNESL),NWFSG(JKRPS),--
        NSJ,NWFSG(JNEN),NWFSG(JNEQ),NWFSG(JNESL),NWFSG(JKRPS),--
        NOE,N1OE,NHT,NFS,NHDT,NSIT,NSJT,  --
               nwt,NWF,NWTH,NWTC)

      IF  NOE = 0 THEN EXIT ERRCD = 2330
      JT = 1 ; ICONF = JA
      WHILE JT <= NJRPS ;
      DO ;
         ICONF = ICONF + 1 ;
         JADT=JNESL+JT*NSJ-1
         FOR IWT=1,NSJT ;
         ( KT = IVAD(IWT) ; IWVAD (KT) = NWFSG(IWT+JADT) )
         CALL STORE(NOE,N1OE,ICONF,ICONF)
         NOET=NOET+NOE
         N1OET=N1OET+N1OE
         JT = JT + 1 ;
         END ;
      CALL STOREH(NOE,ERRCD)
      IF ERRCD > 0 THEN EXEC ERROR_INFORMATION
      NOEC=NOEC+NOE
      N1OEC=N1OEC+N1OE
      END

  > ERROR SAME CONFIG
      2L ; ERRCD = 2210
      1L ; ' ==== ERROR STOP IN %SUBNAME ========== RETURN CODE IS ' ;
      PUT ERRCD I5 ;
      FORMAT WRITE IA,JA
      ( '0VECTORS  ',I5,' AND',I5,  --
        ' ARE IDENTICAL.      ********   ERROR   ********')
      2L; ' == PLEASE CHECK YOUR INPUT DATA == ' ; 1L ;
      EXEC DEBUG_PRINT_1
      /*  CHANGE STOP STATEMENT  JUNE 12 90
      CALL ERSTOP('%SUBNAME')
      END

   PROCEDURE TIME_PRINT
      CALL CLOCKM(ITOUT)
      USEDS = (ITOUT - ITIN)/1000
      USEDMS= MOD((ITOUT-ITIN),1000)
      1L ; ' > EXPRESSION USED ' ;
      PUT USEDS I4 ; ' SEC ' ; PUT USEDMS I4 ;
      ' M SEC OF CPU TIME ' ; 2L
      END

    PROCEDURE TIME_IN
      CALL CLOCKM(ITIN) ; 1L ; IF NPFLG > 0 THEN ITIN2 = ITIN
      END

  >   READ_WAVE_FUNCTION_HEAD
      BINARY READ : NFWFA %IOR --
          NAMEB,NWT,NWF,ISPIN,IORB,IPAR,ITNEL,--
          (NWTN(I),I=1,NWT),  (NWTC(I),I=1,NWF), --
          NREFX, (NWSQ(I),I=1,NWT),  NSDCI, NOREF ; // itotmx
   
   /*KGN  07/90 CHANGE LENGTH OF NWSQ
   /*     NREF, NWSQ, NSDCI, NDUMY
      %%ERRCD 2010 % ; %IOCHECK
      BINARY READ : NFWFA %IOR NAME
      %%ERRCD 2011 % ; %IOCHECK
      IF ERRCD > 0 THEN EXIT
      IF RULE = 3 THEN  DO
         NREF0 = NREFX
         END
      ELSE DO
         NOREF = NREF0
         END
      
      IF NSDCI ^= RULE THEN EXIT ERRCD = 2012
      IF NPFLG > 2 THEN EXEC PRINT_HEAD
      WMUL=1.0D0/DSQRT(DFLOAT(ISPIN*IORB))
      CALL QSHMSB(WMUL)
      J=1
      FOR I=1,NWT
      DO
         LF=MOD(NWTN(I),BYT)
         NWTH(I)=LSQN(LF,LF+1,1)*BYT
         DO WHILE ( J <= NWF & NWTC(J) <= I )
            IF NWTC(J) = I THEN EXIT NWTH(I) = NWTH(I) + 2*LF
            J = J + 1 ;
            END ;
         END ;
    / CALL   QSMAT(NWF,NWTH,NWTC,NFWFW,IWAD,IVAD,IWVAD)
      call setiad(NWT,NWTH,ISSH,INTBL,NWSQ,  LMAX)
  /   LMAX = ISQTQ(NWT,NWTH,IGCD,ISCD,LISL,ISSH,INTBL,NWSQ)
      IF NPFLG > 2  THEN --
      FORMAT WRITE (ISSH(I),I=1,LMAX) ; ('0ISSH  =',15I7/(/8X,15I7))

 /* WRITE WAVE FUNCTION HEADDER
 /* NDUMY REPLACED BY MXLBUF ( LENGTH OF READ BUFFER FOR NWFSG )
      BINARY WRITE : NFWFB %IOW --
          NAMEB,NWT,NWF,ISPIN,IORB,IPAR,ITNEL,--
          (NWTN(I),I=1,NWT),  (NWTC(I),I=1,NWF), --
           NREF, (NWSQ(I),I=1,NWT),  NSDCI, RULE, MXLBUF
   /*KGN  07/90 CHANGE LENGTH OF NWSQ
   /*      NREF, NWSQ,  NSDCI, RULE, MXLBUF
      %%ERRCD 2021 % ; %IOCHECK
      BINARY WRITE  : NFWFB %IOW NAME
      %%ERRCD 2022 % ; %IOCHECK
      END

  > PRINT_HEAD

      FORMAT  WRITE NAMEB,NWT,NWF,ISPIN,IORB,IPAR,ITNEL
       ('0NAME  =',2X,30A4/'0NWT   =',I7,7X,'NWF   =',I7/  --
        '0SPIN  =',I7,7X,'ORB   =',I7,7X,'PAR   =',I7,7X,'TNEL  =',I7)
      FORMAT WRITE (NWTN(I),I=1,NWT)
       ('0NWTN  =',4(1X,Z4,1X,Z4,1X,Z4,1X,Z4,1X,Z4,3X)/    --
        (8X,4(1X,Z4,1X,Z4,1X,Z4,1X,Z4,1X,Z4,3X)))
      FORMAT WRITE (NWTC(I),I=1,NWF)
        ('0NWTC  =',4(1X,Z4,1X,Z4,1X,Z4,1X,Z4,1X,Z4,3X))
      FORMAT WRITE  IISP,IISQT,ISHMS,ICFAC,ISMAT,ICFP,IAFACT,INTBL, --
                    ICVAL   ,IWFIN
       ('0IISP  =',I7,7X,'IISQT =',I7,7X,'ISHMS =',I7,7X,'ICFAC =', --
        I7,7X,'ISMAT =',I7,7X,'ICFP  =',I7,7X//                     --
        ' IAFACT=',I7,7X,'INTBL =',I7,7X,'ICVAL =',I7,7X,'IWFIN =',I7)
      END ;
 > READ_REFERENCE_WAVE_FUNCTION
      INT=0  ; ITSTV=0
      DO UNTIL ITSTV = NREF0 ;
         FORTRAN READ(NFWFA,ERR=999,END=200) --
                 ITOT,(NWFSG(INT+I),I=1,ITOT)
         JS    =INT+1
         NSJ   =NWFSG(JS)   ; /* NUMBER OF SHELLS
         NJRPS =NWFSG(JS+1) ; /* NUMBER OF SAME TYPE CONFIGURATION
         JNEN  =JS+2        ; /* ADDR FOR SHELL ID
         JNEQ  =JNEN+NSJ    ; /* ADDR FOR OCCUPATION NUMBER
         JNESL =JNEQ+NSJ    ; /* ADDR FOR SHELL COUPLING
         EXEC PRINT_CSF
         IF NJRPS ^= 1 THEN EXIT ERRCD = 2101
         ITSTV=ITSTV+NJRPS
         INT=INT+ITOT
         END
      INTREF = INT  ;  NREF = ITSTV
      IF NREF ^= NREF0 THEN ERRCD = 2102
      EXIT
      FORTRAN 200 CONTINUE ; /* END OF FILE NFWFA
      1L ; ' ** EOF DETECTED IN READING NFWFB0 ( CSF FILE ) '
      PUT NFWFA I4 ; 1L ;
      ERRCD = 2110
      END ;
   %WFERINF

      PROCEDURE PRINT_CSF
       /  JS    = INT+1      ; /* THESE PARAMETER WAS ALREADY DEFINED
       /  NSJ   =NWFSG(JS)   ; /* NUMBER OF SHELLS
       /  NJRPS =NWFSG(JS+1) ; /* NUMBER OF SAME TYPE CONFIGURATION
       /  JNEN  =JS+2        ; /* ADDR FOR SHELL ID
       /  JNEQ  =JNEN+NSJ    ; /* ADDR FOR OCCUPATION NUMBER
       /  JNESL =JNEQ+NSJ    ; /* ADDR FOR SHELL COUPLING
         FOR I  = 1, NSJ
         DO ;
            IREP  (I) = NWFSG(JNESL + I - 1) / BYT
 /*                              CHANGED BY SUBHAS ON 11/17/89 AT KGN
 /*         LREP  (I) = LCODa ( MOD (NWFSG (JNESL+I-1), BYT) )
            I4TEMP    = NWFSG (JNESL+I-1)
            LREP  (I) = LCODa ( MOD (I4TEMP, BYT) )
 /*                                                END
            ISH       = NWFSG(JNEN-1+I)
            ISHREP(I) = ISP(ISH)
            LSHREP(I) = LCODa(IOR(ISH))
            END ;
         FORMAT WRITE --
         ITSTV+NJRPS,--
         (  NWFSG(JNEN-1+I),ISHREP(I),LSHREP(I),I=1,NSJ)
         (/'  TO ',I8,3X, 8(Z6,'-',I2,A1,' > ') --
          /(         15X, 8(Z6,'-',I2,A1,' > ')))
     /   IF NPFLG > 2 THEN KKK = NJRPS ;/ELSE KKK = 1  JUNE 29 90
         IF NPFLG > 1 THEN KKK = NJRPS ; ELSE KKK = 1
         FOR III = 1, KKK
         DO
            LLL = NSJ*III
            FOR I  = 1, NSJ
            DO ;
               ISHREP (I) = --
                   NWTN(NWFSG(JNESL + LLL + I  - 1))/ BYT
               LSHREP (I) = --
                   LCODa(MOD(NWTN(NWFSG(JNESL+LLL+I-1)), BYT) )
               END ;
            FORMAT WRITE ITSTV+III, --
            (ISHREP(I),LSHREP(I),NWFSG(JNEQ-1+I),--
             IREP(I),LREP(I),I=1,NSJ)
            (5X,I8,'>',1X,8(I4,A1,'*',I2,'(',I2,A1,')') --
             /(15X,8(I4,A1,'*',I2,'(',I2,A1,')  ')))
            END
         END
