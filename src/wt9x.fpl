        /*             XX
        DO FOR M = NL(3)+1, NL(4) - 1 ;
           HSC(M) = HSC(M-1) ; HRC(M)=HRC(M-1) ; NOP(M) = 1 ;
           HSX(M) = %S       ; HRX(M)= %S      ; MODE(M) = %I
           END ;
        /* --(H1H2)--H3--H4--
        /*               XX
        M = NL(4)   ; MODE(M)= MD(4) ; NOP(M)= 1 ;
        HSX(M) = %D ; HRX(M) = HL(4) ;
        HSC(M) = %S ; HRC(M) = %S    ;
        DO FOR M = NL(4)+1, NHT ;
           HSC(M) = HSC(M-1) ; HRC(M)=HRC(M-1) ; NOP(M) = 0 ;
           HSX(M) = %S       ; HRX(M)= %S      ; MODE(M) = %I
           END ;
        MI = NL(1) ; ME = NHT ; EXEC FACTORIZATION ;
        END ;

     PROCEDURE OPERATOR_SET_NORMAL_C34
        /* --H1--H2--(H3H4)--
        /*   XX
        M = NL(1)   ; MODE(M)= MD(1) ; NOP(M)= 4 ;
        HSX(M) = %D ; HRX(M) = HL(1) ;
        HSC(M) = %D ; HRC(M) = HL(1) ;
        /* --H1--H2--(H3H4)--
        /*   XX
        DO FOR M = NL(1)+1, NL(2) - 1 ;
           HSC(M) = HSC(M-1) ; HRC(M)=HRC(M-1) ; NOP(M) = 3 ;
           HSX(M) = %S       ; HRX(M)= %S      ; MODE(M) = %I
           END
        /* --H1--H2--(H3H4)--
        /*       XX
        M = NL(2)   ; MODE(M)= MD(2) ; NOP(M)= 3 ;
        HSX(M) = %D ; HRX(M) = HL(2) ;
        HSC(M) = LSI; HRC(M) = LRI   ;
        /* --H1--H2--(H3H4)--
        /*         XX
        DO FOR M = NL(2)+1, NL(3) - 1 ;
           HSC(M) = HSC(M-1) ; HRC(M)=HRC(M-1) ; NOP(M) = 2 ;
           HSX(M) = %S       ; HRX(M)= %S      ; MODE(M) = %I
           END ;
        /* --H1--H2--(H3H4)--
        /*             XX
        M = NL(3)   ; MODE(M)= MD(3) ; NOP(M)= 2 ;
        HSX(M) =LSI ; HRX(M) = LRI   ;
        HSC(M) = %S ; HRC(M) = %S    ;
        /* --H1--H2--(H3H4)--
        /*                 XX
        DO FOR M = NL(4)+1, NHT ;
           HSC(M) = HSC(M-1) ; HRC(M)=HRC(M-1) ; NOP(M) = 0 ;
           HSX(M) = %S       ; HRX(M)= %S      ; MODE(M) = %I
           END ;
        MI = NL(1) ; ME = NHT ; EXEC FACTORIZATION ;
        END ;

