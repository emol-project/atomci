  process file 'wt9x.f'
  %%SUBNAME WT9X%
  PROCESS NO LIST      MAP    HEADER  %SUBNAME
  FUNCTION    %SUBNAME --
                  ( HSX, HSI, HST, HRX, HRI, HRT, --
                    FSX, FSI, FST, FRX, FRI, FRT, --
                    GSX, GSI, GST, GRX, GRI, GRT, --
                    WFF, WFG, NFQ, NGQ,           --
                    JSI, JRI, NOP, MODEOP,ITEST )
  %UPDATE
  /*
  /*
  /*
  /*   CALLED  SUBROUTINE :  FACTOR
  /*   CALLING SUBROUTINE :  CFP WIG6J WIG9X CFACRC
  /*
  /*     FUNCTION : FACTORIZATION
  /*                USING RECOUPLING FORMULA
  /*
  /*   ENTRY :  
  /*
  /*
  /*                          PROGRAMMED BY M. SEKIYA 11-23-1986
  /*                          CHANGED   BY TASHI     10-24-1989
  /*
  /*                       FORTRAN77 AND FPL ( FORTRAN PRE PROCESSOR )
  /*
  IMPLICIT INTEGER * 4 (A-Z)
  /* PREPROCESSOR      SINGLET DOUBLET .... */
     %%S    1%
     %%D    2%
     %%T    3%
     %%I  0%
     %%C  1%
     %%A  2%
     %%CC  3%
     %%AA  4%
     %%CA  5%
     %%AC  6%
     %%CCA  7%
     %%CAC  8%
     %%CAA  9%
     %%ACA  10%
     %%CACA  11%
     %%SK  KSTACT = KSTACT + 1;  KSTACK(KSTACT) %
     %%UK  KSTACK(KSTACT);  KSTACT = KSTACT - 1 %
     /* END OF PRE DCL
     /* EXTERNAL FUNCTION OR STATEMENT FUNCTION
     EXTERNAL IOR,IQS,ISP,CFP,WIG9X,WIG6J,ILFO,CFACRC
     REAL * 8 ZP,WT9X,WIG9X,WIG6J,CFP,CFACRC
     INTEGER * 4 IOR,IQS,ISP,ILFO
     /* INPUT PARAMETER */
     INTEGER * 4       HSX, HSI, HST, HRX, HRI, HRT, -- OPERATOR
                       FSX, FSI, FST, FRX, FRI, FRT, -- RIGHT CSF
                       GSX, GSI, GST, GRX, GRI, GRT, -- LEFT  CSF
                       WFF, WFG, NFQ, NGQ,           -- SHELL & # OF EL
                       JSI, JRI, NOP, MODEOP       ;
     /
     %comwfa
     INTEGER * 4            ITEST            ; /* DEBUG FLAG
     /* DCL FOR LOCAL  VAR ( REAL * 8 )
     REAL    * 8  ET               , -- FACTOR FOR < !A!L> ETC.
                  WT,WTL,WTR       , -- WEIGHT FACTOR ( USING SUM UP )
                  SLES             ; /* THRESHOLD FOR FACTOR
     REAL   * 8   RVALUE
     /* DCL FOR LOCAL  VAR ( INTEGER * 4 )
     INTEGER * 4  WSL,WRL,WSR,WRR  , -- SPIN AND ORBITAL MULTIPLICITY
                  MODE             , -- MODE OF LK_TABLE
                  LST,LRT          , -- = HSX, HRX,
                  LSI,LRI          , -- = JSI, JRI, ( OR 1 1 )
                  LSO,LRO          , -- LSO=2, LRO SHELL SYMMETRY
                  LS               , -- USING CREATION LABEL
                  NREL             , -- = NFQ ( # OF ELECTRON )
                  DEBUG            ; /* DEBUG FLAG
     / SAS   89-10-30    MOVED
     ZP( IH )  = 1.0D0 - 2.0D0*(MOD( (IH+8888)/2, 2 ) ); /* PHASE
     DATA         SLES/1.0D-10/
     %%DEBUG  /* %
  BEGIN
     DEBUG=ITEST
     EXEC X_WT9X
     END
  > X_WT9X
     IF DEBUG > 0 THEN EXEC DEBUG_PRINT_WEIGHT_TABLE_9X_ENTER
     EXEC LK_TABLE
     IF DABS ( ET ) > SLES THEN --
        WT9X    = ET * ( 1.0D0 - 2.0D0 * MOD( NFQ * NOP, 2 ) ) --
           *    DSQRT ( DFLOAT                                 --
              ( HST * HRT * FSI * FRI * GST * GRT ) )          --
           *     WIG9X ( HSX,      HSI,      HST,              --
                         FSX,      FSI,      FST,              --
                         GSX,      GSI,      GST       )       --
           *     WIG9X ( HRX,      HRI,      HRT,              --
                         FRX,      FRI,      FRT,              --
                         GRX,      GRI,      GRT       )
     ELSE WT9X      = 0.0D0
     IF DEBUG > 0 THEN EXEC DEBUG_PRINT_WEIGHT_TABLE_9X_EXIT
     END

  PROCEDURE DEBUG_PRINT_WEIGHT_TABLE_9X_ENTER ;
     IF DEBUG > 1 THEN DO ;
        FORMAT WRITE ' -->--> ENTER WEIGHT TABLE 9X -->--> ' ;  ( A ) ;
        IF DEBUG > 2 THEN DO ;
           FORMAT WRITE --
           '   VEC, NEL, SPX, SPI, SPT, ORX, ORI, ORT,        ' ; ( A );
           FORMAT WRITE --
               WFF, NFQ, FSX, FSI, FST, FRX, FRI, FRT, ' ( KET ) ' ;
           ( 2X,Z4,1X,Z4,6I5, A ) ;
           FORMAT WRITE --
               WFG, NGQ, GSX, GSI, GST, GRX, GRI, GRT, ' ( BRA ) ' ;
           ( 2X,Z4,1X,Z4,6I5,A  ) ;
           FORMAT WRITE --
                         HSX, HSI, HST, HRX, HRI, HRT, ' (OPERATOR)' ;
           ( 11X,        6I5,A ) ;
           END ;
        END ;
     END ;

  PROCEDURE DEBUG_PRINT_WEIGHT_TABLE_9X_EXIT
     IF DEBUG > 1 THEN --
        FORMAT WRITE '  WEIGHT 9X  >> ',WT9X,--
        '  JSI > ',JSI,'  JRI > ',JRI,'  MODEOP > ',MODEOP ;
        ( A, F14.8, A, I4, A, I4, A, I4 ) ;
     FORMAT WRITE ' <--<-- EXIT  WEIGHT TABLE 9X <--<-- ' ; ( A ) ;
     END ;

  PROCEDURE   LK_TABLE
     LST = HSX ; LRT = HRX ; NREL = NFQ ;
     LSI =   1 ; LRI =   1 ;
  /* PRE DCL */
  %%CFPXX  --
      RVALUE = 0.0D0 ; --
      LRO = ILFO( WFG ) ; L = LRO/2 + 1 ;    --
      LSO = 2 ; --
      LS =   LSI * 2  +  LST  ; --
         WSR = ISP( WFF ) ; WSL = ISP( WFG ) ; --
         WRR = IOR( WFF ) ; WRL = IOR( WFG ) ; --
         %ACTION ; --
      ET = RVALUE ; %
     %%CXXX   1%
     %%XXCX   2%
     %%XAXX   3%
     %%XXXA   4%
     %%CXCX   5%
     %%XAXA   6%
     %%CAXX   7%
     %%XXCA   8%
     %%CXXA   9%
     %%XACX  10%
     %%CXCA  11%
     %%CACX  12%
     %%CAXA  13%
     %%XACA  14%
     %%CACAX 15%
   /* END OF PRE DCL */
     DO CASE OF MODEOP ;
       %I : --
           IF WFG = WFF & NFQ = NGQ
           THEN ET = DSQRT( DFLOAT( FSX * FRX ) ) ;
           ELSE   ET = 0.0D0
       %CXXX :
       %XXCX : --
           IF NFQ + 1 = NGQ  --
           THEN ET = CFP(WFG,WFF,NREL, 1)
           ELSE ET = 0.0D0

       %XAXX :
       %XXXA : --
           IF NFQ - 1 = NGQ  & NFQ > 0
           THEN ET = CFP(WFG,WFF,NREL,-1)
           ELSE ET = 0.0D0

     %%ACTION   EXEC LK_TABLE_CC              %
       %CXCX : --
           IF NFQ + 2 = NGQ THEN --
           DO ;
              MODE = %CC ; %CFPXX ;
              END ;
           ELSE ET = 0.0D0

     %%ACTION   EXEC LK_TABLE_AA              %
       %XAXA : --
           IF NFQ - 2 = NGQ & NFQ > 1 THEN --
           DO ;
              MODE = %AA ; %CFPXX ;
              END ;
           ELSE ET = 0.0D0

     %%ACTION   EXEC LK_TABLE_CA              %
      %CAXX :
      %XXCA :
      %CXXA : --
           IF NFQ = NGQ  & NFQ > 0 THEN --
           DO ;
              MODE = %CA ; %CFPXX ;
              END ;
           ELSE ET = 0.0D0

     %%ACTION   EXEC LK_TABLE_AC              %
      %XACX : --
           IF NFQ = NGQ            THEN --
           DO ;
              MODE = %AC ; %CFPXX ;
              END ;
           ELSE ET = 0.0D0

     %%ACTION   EXEC LK_TABLE_CCA             %
      %CXCA : --
           IF NFQ + 1 = NGQ & NFQ > 0  THEN --
           DO ;
              LSI  = JSI ; LRI = JRI ;
              MODE = %CCA ; %CFPXX ;
              END ;
           ELSE ET = 0.0D0

     %%ACTION   EXEC LK_TABLE_CAC             %
      %CACX : --
           IF NFQ + 1 = NGQ & NFQ > 0  THEN --
           DO ;
              LSI  = JSI ; LRI = JRI ;
              MODE = %CAC ; %CFPXX ;
              END ;
           ELSE ET = 0.0D0

     %%ACTION   EXEC LK_TABLE_CAA             %
      %CAXA : --
           IF NFQ - 1 = NGQ & NFQ > 1 THEN --
           DO ;
              LSI  = JSI ; LRI = JRI ;
              MODE = %CAA ; %CFPXX ;
              END ;
           ELSE ET = 0.0D0

     %%ACTION   EXEC LK_TABLE_ACA             %
      %XACA : --
           IF NFQ - 1 = NGQ & NFQ > 1 THEN --
           DO ;
              LSI  = JSI ; LRI = JRI ;
              MODE = %ACA ; %CFPXX ;
              END ;
           ELSE ET = 0.0D0

     %%ACTION   EXEC LK_TABLE_CACA            %
      %CACAX : --
           IF NFQ = NGQ & NFQ > 1 THEN --
           DO ;
              LSI  = JSI ; LRI = JRI ;
              MODE = %CACA ; %CFPXX ;
              END ;
           ELSE ET = 0.0D0

       OTHERWISE FORMAT WRITE ' >> ERROR >> OCCURRED IN WT9X  ' ; ( A );
     IF DEBUG > 1 THEN DO ;
        FORMAT WRITE --
              '  RETURN VALUES LK_T >> ',  ET  ;  ( A, F14.8 ) ;
        FORMAT WRITE  ' --<--< EXIT  LK_TABLE --<--<'  ; ( A ) ;
        END ;
     END

    /* PROCEDURE LK_TABLE
    PROCEDURE LK_TABLE_CC
        RVALUE= 0.0D0
        K =  TOPADR( L ) + NREL + 1
        FOR I = WFADR( K ), WFADR( K ) + NSHL( K ) - 1 ;
        DO ;
           RVALUE= RVALUE--
             + WIG6J( LSO, LST, LSO, WSL, WS(I), WSR )  --
             * WIG6J( LRO, LRT, LRO, WRL, WR(I), WRR )  --
             * CFP  ( WFG, WF( I ), NREL + 1, 1)          --
             * CFP  ( WF(I), WFF,   NREL   , 1)
           END ;
        RVALUE = RVALUE --
               * DSQRT ( DFLOAT( LST * LRT ) ) --
               * ZP( LST + LRT + WSL + WRL + WSR + WRR - 4 )
        /      * ZP( LST + LRT + WSL + WRL + WSR + WRR - 6 )
        /      REVISED BY MAS 11/15/86
        END ;
    PROCEDURE LK_TABLE_AA
        RVALUE= 0.0D0
        K =  TOPADR( L ) + NREL - 1
        FOR I = WFADR( K ), WFADR( K ) + NSHL( K ) - 1 ;
        DO ;
           RVALUE= RVALUE--
             + WIG6J( LSO, LST, LSO, WSL, WS(I), WSR )  --
             * WIG6J( LRO, LRT, LRO, WRL, WR(I), WRR )  --
             * CFP  ( WFG, WF( I ), NREL - 1,-1)          --
             * CFP  ( WF(I), WFF,   NREL   ,-1)
           END
        RVALUE = RVALUE --
               * DSQRT( DFLOAT ( LST * LRT ) )  --
               * ZP( LST + LRT + WSL + WRL + WSR + WRR - 4 )
        /      * ZP( LST + LRT + WSL + WRL + WSR + WRR - 6 )
        /      REVISED BY MAS 11/15/86
        END ;
    PROCEDURE LK_TABLE_CA
        RVALUE= 0.0D0
        K =  TOPADR( L ) + NREL - 1
        FOR I = WFADR( K ), WFADR( K ) + NSHL( K ) - 1 ;
        DO ;
           RVALUE= RVALUE--
             + WIG6J( LSO, LST, LSO, WSL, WS(I), WSR )  --
             * WIG6J( LRO, LRT, LRO, WRL, WR(I), WRR )  --
             * CFP  ( WFG, WF( I ), NREL - 1,1)         --
             * CFP  ( WF(I), WFF,   NREL   ,-1)
           END
        RVALUE=   RVALUE--
               * DSQRT( DFLOAT ( LST * LRT ) )  --
               * ZP( LST + LRT + WSL + WRL + WSR + WRR - 4 )
        END ;
    PROCEDURE LK_TABLE_AC
        EXEC LK_TABLE_CA
        RVALUE = RVALUE * ZP( LST + LRT - 2 )
       /IF LST = 1 & LRT = 1 & WFG = WFF THEN --
       /   DO ;
       /   RMALUE= RVALUE + DSQRT( DFLOAT ( LSO * LRO ) )
       /   END
        END ;
    PROCEDURE LK_TABLE_CCA
        RVALUE= 0.0D0
        K =  TOPADR( L ) + NREL
        FOR I = WFADR( K ), WFADR( K ) + NSHL( K ) - 1 ;
        DO ;
           WT = CFACRC(WF(I),WFF,NREL,LSI,LRI)
           IF DABS ( WT ) < SLES THEN EXIT ;
           RVALUE= RVALUE--
             + WIG6J( LSI, LST, LSO, WSL, WS(I), WSR )  --
             * WIG6J( LRI, LRT, LRO, WRL, WR(I), WRR )  --
             * CFP  ( WFG, WF( I ), NREL   , 1)           --
             * WT
           END ;
        RVALUE= RVALUE --
          * DSQRT ( DFLOAT ( LST * LRT ) ) --
          * ZP ( WSL + WRL + LST + LRT + WSR + WRR - 6 )
        END ;
    PROCEDURE LK_TABLE_CAC
        EXEC LK_TABLE_CCA
        RVALUE= RVALUE* ZP( LRO + LSO + LSI + LRI - LST - LRT - 2)
      /*IF LST = LSO & LRT = LRO THEN --
      /*VVALUE= RVALUE --
      /*  + DSQRT( DFLOAT( LSI * LRI ) --
      /*  / DFLOAT( LSO * LRO ))--
      /*  * CFP( WFG, WFF, NREL, 1) * ZP( LSI + LRI - 2 )
        END ;
    PROCEDURE LK_TABLE_CAA
        RVALUE= 0.0D0
        K =  TOPADR( L ) + NREL - 1
        FOR I = WFADR( K ), WFADR( K ) + NSHL( K ) - 1 ;
        DO ;
           WT = CFACRC(WFG,WF(I),NREL-1,LSI,LRI)
           IF DABS ( WT ) < SLES THEN EXIT ;
           RVALUE= RVALUE--
             + WIG6J( LSO, LST, LSI, WSL, WS(I), WSR )   --
             * WIG6J( LRO, LRT, LRI, WRL, WR(I), WRR )   --
             * CFP  ( WF(I), WFF, NREL   ,-1)              --
             * WT
           END ;
        RVALUE= RVALUE* DSQRT( DFLOAT ( LST * LRT )) --
          * ZP ( WSL + WRL + LST + LRT + WSR + WRR - 6 )
        END ;
    PROCEDURE LK_TABLE_ACA
        EXEC LK_TABLE_CAA
        RVALUE= RVALUE * ZP( LRO + LSO + LSI + LRI - LST - LRT -2)
      /*IF LST = LSO & LRT = LRO THEN --
      /*VVALUE= RVALUE --
      /*  + DSQRT( DFLOAT( LSI * LRI ) --
      /*  / DFLOAT( LSO * LRO ))--
      /*  * CFP( WFG, WFF, NREL,-1) * ZP( LSI + LRI - 2 )
        END ;
    PROCEDURE LK_TABLE_CACA
        RVALUE= 0.0D0
        K =  TOPADR( L ) + NREL
        FOR I = WFADR( K ), WFADR( K ) + NSHL( K ) - 1 ;
        DO ;
           WTL = CFACRC(WFG,WF(I),NREL,LSI,LRI)
           IF DABS ( WTL ) < SLES THEN EXIT ;
           WTR = CFACRC(WF(I),WFF,NREL,LSI,LRI)
           IF DABS ( WTR ) < SLES THEN EXIT ;
           RVALUE= RVALUE--
             + WIG6J( LSI, LST, LSI, WSL, WS(I), WSR )   --
             * WIG6J( LRI, LRT, LRI, WRL, WR(I), WRR )   --
             * WTL * WTR
           END ;
        RVALUE= RVALUE* DSQRT( DFLOAT ( LST * LRT ) )  --
          * ZP ( WSL + WRL + LST + LRT + WSR + WRR - 6 )
        IF LST = 1 & LRT = 1 THEN --
        DO ;
           RVALUE = RVALUE --
              + CFACRC(WFG,WFF,NREL,  1,  1) --
              * DSQRT( DFLOAT( LSI * LRI ) /DFLOAT(LSO*LRO) )
           END ;
        END ;
  %%SUBNAME FACTOR%
  PROCESS    NO LIST      MAP    HEADER  %SUBNAME
  FUNCTION  %SUBNAME --
         ( ITEST, FSX, FRX, FSC, FRC, GSX, GRX, GSC, GRC, --
           HSX, HRX, HSC, HRC, NHVN, NHWN, FN, GN, --
           NL,HL,MD,LSI,LRI,LSF,LRF,LST,LRT,NHT,MODEP,PAIR,PHASE,MP)
  %UPDATE
  /*
  /*   CALLED  SUBROUTINE :  SHMSRC
  /*   CALLING SUBROUTINE :  WT9X
  /*
  /*     FUNCTION :
  /*       GENERATE OPERATOR COUPLING SCHEME AND CALC RECOUPLING FACTOR
  /*
  /*                          PROGRAMMED BY M. SEKIYA 11-23-1986
  /*                          CHANGED   BY TASHI     10-24-1989
  /*
  /*                          FORTRAN77 AND FPL ( FORTRAN PRE PROCESSOR )
  /*
  IMPLICIT REAL*8(A-H,O-Z)
  /* DCL PARAMETER */
     %%MAX_SHELL  11%
     INTEGER * 4 LSF,LRF,LST,LRT
     INTEGER * 4 NL(4),MD(4),HL(4),LSI,LRI,NHT,MODEP,PAIR(2)
     REAL    * 8 FACTOR,PHASE
     LOGICAL  MP
  /* DCL LOCAL     */
     REAL    * 8 W,WT,ET,ZP,WT9X
     INTEGER * 4 NHWN (%MAX_SHELL)
     INTEGER * 4 NHVN (%MAX_SHELL)
     INTEGER * 4 FN  (%MAX_SHELL)
     INTEGER * 4 GN  (%MAX_SHELL)
     INTEGER * 4 HSX (%MAX_SHELL),HRX (%MAX_SHELL)
     INTEGER * 4 FSX (%MAX_SHELL),FRX (%MAX_SHELL)
     INTEGER * 4 GSX (%MAX_SHELL),GRX (%MAX_SHELL)
     INTEGER * 4 HSC (0:%MAX_SHELL),HRC (0:%MAX_SHELL)
     INTEGER * 4 FSC (0:%MAX_SHELL),FRC (0:%MAX_SHELL)
     INTEGER * 4 GSC (0:%MAX_SHELL),GRC (0:%MAX_SHELL)
     INTEGER * 4 MODE(%MAX_SHELL),  NOP (%MAX_SHELL)
     INTEGER * 4 NSH, M, EXFLG ;
     REAL    * 8 SLES
     INTEGER * 4 DEBUG
     %%BUFFER  100%
     INTEGER * 4 KSTACT,KSTACK(%BUFFER) ;
     /  SAS 89-10-30
     DATA        EXFLG/0/ ;
     DATA        SLES/1.0D-10/
     /* PREPROCESSOR      SINGLET DOUBLET .... */
     %%SK  KSTACT = KSTACT + 1;  KSTACK(KSTACT) %
     %%UK  KSTACK(KSTACT);  KSTACT = KSTACT - 1 %
     %%NOT  MSHELL = 0 %
     %%SAME MSHELL = 1 %
     %%S    1%
     %%D    2%
     %%T    3%
     /* OPERATOR TYPE*/
     %%I  0%
     %%C  1%
     %%A  2%
     %%CC  3%
     %%AA  4%
     %%CA  5%
     %%AC  6%
     %%CCA  7%
     %%CAC  8%
     %%CAA  9%
     %%ACA  10%
     %%CACA  11%
     %%CXXX   1%
     %%XXCX   2%
     %%XAXX   3%
     %%XXXA   4%
     %%CXCX   5%
     %%XAXA   6%
     %%CAXX   7%
     %%XXCA   8%
     %%CXXA   9%
     %%XACX  10%
     %%CXCA  11%
     %%CACX  12%
     %%CAXA  13%
     %%XACA  14%
     %%CACA  15%
     /* RECOUPLING TYPE
     %%NONE    1%
     %%NONEC12 2%
     %%NORMAL  3%
     %%NC12    4%
     %%NC34    5%
     %%NC123   6%
     %%NC234   7%
     %%NC12C34 8%
     %%NC1234  9%
     %%NM23   10%
     %%NR23   11%
     %%NR123  12%
     %%NR234  13%
     %%NR1234 14%
     %%ZERO_EXIT  IF DABS(W) < SLES THEN EXIT %
  /*     (HSC(M-1),HSX(M))--> HSC(M)
  /*     (HRC(M-1),HRX(M))--> HRC(M)
  /*     (FSC(M-1),FSX(M))--> FSC(M)
  /*     (FRC(M-1),FRX(M))--> FRC(M)
  /*    NHWN : SHELL STATE
  /*   FN    : # OF ELECTRON IN OPEN SHELL
  /*   GSC: COUPLING SCHEME
  /*   GSX ***: LEFT STATE VECTOR
  /*   FSX ***: RIGHT STATE VECTOR

  /* STATEMENT FUNCTION
     ZP( IH )  = 1.0D0 - 2.0D0*(MOD( (IH+8888)/2, 2 ) ); /* PHASE
     MAXS(I,J) = I + J - 1
     MINS(I,J) = IABS( I - J ) + 1
  BEGIN
     DEBUG = ITEST
     EXEC  X_FACT
     END

  PROCEDURE X_FACT
     IF DEBUG > 0 THEN EXEC DEBUG_PRINT_FIRST
  /* SET INITIAL VALUE */
     W = 0.0D0 ; FACTOR = 0.0D0; ET = 1.0D0
                 WT = 0.0D0    ;
     KSTACT = 0 ; LSM = 0 ; LRM = 0 ;
     /* CALC FOR 1->NL(1)-1
     HSC(0) = %S ; HRC(0) = %S;
     DO FOR NSH = 1, NL(1) - 1  ;
        IF NHWN(NSH) ^= NHWN(NSH) ! FN  (NSH) ^= GN  (NSH) ! --
           FSC (NSH) ^= GSC (NSH) ! FRC (NSH) ^= GRC (NSH)   --
           THEN ( FACTOR = 0.0D0 ; RETURN )
        HSC(NSH) = %S ; HRC(NSH) = %S;
        END ;
     /* OPERATOR SEQUENCE IS NL(1),NL(2),NL(3),NL(4)
     /*       ASSUMPTION
     /*            C1 < C2
     %%WT9X      WT9X  --
                      (HSX(NSH), HSC(NSH-1), HSC(NSH)  ,--
                       HRX(NSH), HRC(NSH-1), HRC(NSH)  ,--
                       FSX(NSH), FSC(NSH-1), FSC(NSH)  ,--
                       FRX(NSH), FRC(NSH-1), FRC(NSH)  ,--
                       GSX(NSH), GSC(NSH-1), GSC(NSH)  ,--
                       GRX(NSH), GRC(NSH-1), GRC(NSH)  ,--
                       NHVN(NSH),NHWN(NSH),  FN(NSH),   GN(NSH), --
                       LSI, LRI, NOP(NSH),   MODE(NSH), DEBUG) ;%
     %%RCPLZZ DSQRT( DFLOAT( LSI * LRI * LSM * LRM ) ) --
              * ZP( LSM + LRM - 2 )  --
              * WIG6J( %D   , %D   , LSM, %D , %D , LSI ) --
              * WIG6J( HL(1),     HL(2),       LRM, --
                       HL(PAIR(2)), HL(PAIR(1)), LRI ) %
     %%RCPLXX DSQRT( DFLOAT( LSI * LRI * LSM * LRM ) ) --
              * WIG6J( %D   , %D   , LSM, %D , %D , LSI ) --
              * WIG6J( HL(1),     HL(2),       LRM, --
                       HL(PAIR(2)), HL(PAIR(1)), LRI ) %
     %%RCPLYY DSQRT( DFLOAT( LSI * LRI * LSM * LRM ) ) --
              * WIG6J( %D   , %D   , LSM, %D , %D , LSI ) --
              * WIG6J( HL(2),     HL(3),       LRM, --
                       HL(1),     HL(4),       LRI ) %
     DO CASE OF MODEP
        %NONE   : EXEC OPERATOR_SET_1EL ;
        %NONEC12: EXEC OPERATOR_SET_1EL_C12 ;
        %NORMAL : EXEC OPERATOR_SET_NORMAL ;
        %NC12   : EXEC OPERATOR_SET_NORMAL_C12 ;
        %NC34   : EXEC OPERATOR_SET_NORMAL_C34 ;
        %NC123  : EXEC OPERATOR_SET_NORMAL_C123;
        %NC234  : EXEC OPERATOR_SET_NORMAL_C234;
        %NC12C34: EXEC OPERATOR_SET_NORMAL_C12_C34;
        %NC1234 : EXEC OPERATOR_SET_NORMAL_C1234
        %NM23   : EXEC OPERATOR_SET_RCPL_C23
        %NR23   : EXEC OPERATOR_SET_RCPL_23
        %NR123  : EXEC OPERATOR_SET_RCPL_C12_3
        %NR234  : EXEC OPERATOR_SET_RCPL_2_C34
        %NR1234 : EXEC OPERATOR_SET_RCPL_C12_C34
        *         EXEC ERROR_PRINT
        END ;
     FACTOR = W * PHASE ;
     IF DEBUG > 0  THEN EXEC DEBUG_PRINT_FIN
     END
  PROCEDURE ERROR_PRINT ;
     FORMAT WRITE --
     '  >> ERROR >> IN FACTOR >> ERRROROR >> ' ; ( A ) ;
     FACTOR = 0.0D0 ;
     END ;

  PROCEDURE FACTORIZATION
     W = 1.0D0
     DO FOR NSH = MI,  ME ;
        W = W * %WT9X ;
        %ZERO_EXIT W = 0.0D0
        END ;
     END ;
     PROCEDURE OPERATOR_SET_RCPL_C12_C34
        /* --(H1H2)--(H3H4)--
        /*                 XX
        M = NL(4)
        HSC(M) = %S ; HRC(M) = %S    ;
        DO FOR M = NL(4)+1, NHT ;
           HSC(M) = HSC(M-1) ; HRC(M)=HRC(M-1) ; NOP(M) = 0 ;
           HSX(M) = %S       ; HRX(M)= %S      ; MODE(M) = %I
           END ;
        %SAME
        EXEC FIND_MID_STATE
        IF KSTACT = 0 THEN EXIT
        WHILE KSTACT >= 2  ;
        DO ;
           LSM = %UK   ; LRM = %UK ;
           IF MP
           THEN ET = %RCPLZZ
           ELSE ET = %RCPLXX
           IF DABS(ET) < SLES THEN EXIT
           /* --(H1H2)--(H3H4)--
           /*     XX
           M = NL(1)   ; MODE(M)= MD(1) ; NOP(M)= 4 ;
           HSX(M) = LSM; HRX(M) = LRM   ;
           HSC(M) = HSX(M) ; HRC(M) = HRX(M) ;
           /* --(H1H2)--(H3H4)--
           /*         XX
           DO FOR M = NL(2)+1, NL(3) - 1 ;
              HSC(M) = HSC(M-1) ; HRC(M)=HRC(M-1) ; NOP(M) = 2 ;
              HSX(M) = %S       ; HRX(M)= %S      ; MODE(M) = %I
              END ;
           /* --(H1H2)--(H3H4)--
           /*             XX
           M = NL(3)   ; MODE(M)= MD(3) ; NOP(M)= 2 ;
           HSX(M) = HSX(NL(1)) ;
           HRX(M) = HRX(NL(1)) ;
           HSC(M) = %S ; HRC(M) = %S    ;
           MI = NL(1)  ; ME = NHT       ; EXEC FACTORIZATION ;
           WT = WT + W * ET ; /* ET IS RECOUPLING COEFFICIENT
           W  = 0.0D0
           END ;
        W = WT ;
        END ;
     PROCEDURE OPERATOR_SET_RCPL_C12_3
        /* --(H1H2)--H3--H4--
