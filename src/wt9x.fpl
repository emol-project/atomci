     PROCEDURE OPERATOR_SET_NORMAL_C12
        /* --(H1H2)--H3--H4--
        /*     XX
        M = NL(1)   ; MODE(M)= MD(1) ; NOP(M)= 4 ;
        HSX(M) = LSI; HRX(M) = LRI   ;
        HSC(M) = LSI; HRC(M) = LRI   ;
