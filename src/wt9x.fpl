   PROCEDURE DEBUG_PRINT_FIRST ;
      FORMAT WRITE ' --->---> ENTER FACTOR --->---> ' ; ( A ) ;
      IF DEBUG > 2 THEN DO ;
         FORMAT WRITE '   NL1,NL2,NL3,NL4, HL1,HL2,HL3,HL4,', --
         ' MD1,MD2,MD3,MD4,  LSI, LRI,MODE,PAIR,        PHASE' ;
                    ( A , A ) ;
         FORMAT WRITE ( NL(N),N=1,4 ), ( HL(N),N=1,4 ),--
                      ( MD(N),N=1,4 ), --
                       LSI, LRI, MODEP, PAIR(1),PAIR(2),PHASE;
                      ( 1X,3(4I4,1X),5I5, F16.8 ) ;
         END ;
      END ;
   PROCEDURE DEBUG_PRINT_FIN   ;
      IF DEBUG > 1 THEN DO ;
         IF  DEBUG > 2 THEN --
         DO ;
            FORMAT WRITE ' >> ATTENTION >>  >>> LSI LRI <<< ', --
                          LSI,LRI ; (A,2I6) ;
            FORMAT WRITE ' LEFT     SPIN     >> ',( GSX(N),N=1,NHT ) ;
            ( A,5X,11I5 )  ;
            FORMAT WRITE ' LEFT     ANGULAR  >> ',( GRX(N),N=1,NHT ) ;
            ( A,5X,11I5 )  ;
            FORMAT WRITE ' COUPLING SCHEME SP>> ',( GSC(N),N=0,NHT ) ;
            ( A,3X,12I5 )  ;
            FORMAT WRITE ' COUPLING SCHEME AN>> ',( GRC(N),N=0,NHT ) ;
            ( A,3X,12I5 )  ;
            FORMAT WRITE ' RIGHT    SPIN     >> ',( FSX(N),N=1,NHT ) ;
            ( A,5X,11I5 )  ;
            FORMAT WRITE ' RIGHT    ANGULAR  >> ',( FRX(N),N=1,NHT ) ;
            ( A,5X,11I5 )  ;
            FORMAT WRITE ' COUPLING SCHEME SP>> ',( FSC(N),N=0,NHT ) ;
            ( A,3X,12I5 )  ;
            FORMAT WRITE ' COUPLING SCHEME AN>> ',( FRC(N),N=0,NHT ) ;
            ( A,3X,12I5 )  ;
            END ;
         FORMAT WRITE ' OPERATOR SPIN     >> ',( HSX(N),N=1,NHT ) ;
         ( A,5X,11I5 )  ;
         FORMAT WRITE ' OPERATOR ANGULAR  >> ',( HRX(N),N=1,NHT ) ;
         ( A,5X,11I5 )  ;
         FORMAT WRITE ' COUPLING SCHEME SP>> ',( HSC(N),N=0,NHT ) ;
         ( A,3X,12I5 )  ;
         FORMAT WRITE ' COUPLING SCHEME AN>> ',( HRC(N),N=0,NHT ) ;
         ( A,3X,12I5 )  ;
         FORMAT WRITE ' DUMP KSTACK       >> ',--
                      ( KSTACK(N),N=1,20);
         ( A,/(3X,5('(L>',I3,' S>',I3,' ) ')) )   ;

         END ;
      FORMAT WRITE ' FACTOR>>',FACTOR , --
                   ' PHASE >>',PHASE  , --
                   ' RCPL  >>',ET     ; (  3(A, F14.8, 2X) ) ;
      FORMAT WRITE ' ---<---- EXIT  FACTOR ---<---- ' ; ( A ) ;
      END ;

  PROCEDURE  FIND_MID_STATE
  /* # OF SHELL    = 2
  /* # OF OPERATOR = 2
  /*  1 :  GSC(NSH+1) - FSC(NSH+1) --> SPIN & ORB
  /*  2 :  HL(1) - HL(2)             --> ORB
  /*  3 :  HL(3) - HL(4)             --> ORB
  /* TRIANGLE CONDITION  HL(1) AND HL(2)
  /* MAXOS1 = 3                 ; /* MINOS1 = 1 ;
     MAXOR1 = MAXS( HL(1), HL(2) ) ; MINOR1 = MINS( HL(1), HL(2) )
  /* TRIANGLE CONDITION  HL(3) AND HL(2)
  /* MAXOS2 = 3                 ; /* MINOS2 = 1 ;
     MAXOR2 = MAXS( HL(3), HL(4) ) ; MINOR2 = MINS( HL(3), HL(4) )
  /* TRIANGLE CONDITION  FSC, HSC, GSC
     MAXOS3 = MAXS(FSC(NL(2)),GSC(NL(2)));
     MINOS3 = MINS(FSC(NL(2)),GSC(NL(2)));
     MAXOR3 = MAXS(FRC(NL(2)),GRC(NL(2)));
     MINOR3 = MINS(FRC(NL(2)),GRC(NL(2)));
  /* TRIANGLE CONDITION  FSX(NSH-1), HSX, FSX(NSH) / ASAMPTION
  /* OPERATOR COUPLING FOR SPIN
  /* MAXOPS= MAX0( MAXOS1, MAXOS2 ) ;
  /* MINOPS= MIN0( MINOS1, MINOS2 ) ;
  /* IF MAXOPS < MINOPS THEN EXIT
     IF MAXOS3 < MINOS3 THEN EXIT
     MAXOPR= MIN0( MAXOR1, MAXOR2, MAXOR3 ) ;
     MINOPR= MAX0( MINOR1, MINOR2, MINOR3 ) ;
     IF MAXOPR < MINOPR THEN EXIT

     FOR NSPIN = MINOS3, MAXOS3,  2
     FOR NORB = MINOPR, MAXOPR, 2
     DO ;
       /IF MSHELL = 1 & MOD( NSPIN + NORB, 4 ) = 0 THEN EXIT
        %SK = NORB
        %SK = NSPIN
        END
     END

   %%SUBNAME CFP %
   PROCESS    NO LIST      MAP    HEADER  %SUBNAME
   FUNCTION   %SUBNAME(IM,KM,KMP,ID)
     IMPLICIT REAL*8(A-H,O-Z)
  begin
   %SUBNAME =X%SUBNAME(IM,KM,KMP,ID)
   end

   %%SUBNAME  WIG6J %
   PROCESS    NO LIST      MAP    HEADER  %SUBNAME
   FUNCTION   %SUBNAME(I1,I2,I3,I4,I5,I6)
      IMPLICIT REAL*8(A-H,O-Z)
   BEGIN ;
         RVALUE = XWIG6J(I1,I2,I3,I4,I5,I6)
      WIG6J = RVALUE ;
      END ;
   %%SUBNAME  WIG9X %
   PROCESS    NO LIST      MAP    HEADER  %SUBNAME
   FUNCTION   %SUBNAME(I1,I2,I3,I4,I5,I6,I7,I8,I9)
      IMPLICIT REAL*8(A-H,O-Z)
   BEGIN ;
         RVALUE = XWIG9X(I1,I2,I3,I4,I5,I6,I7,I8,I9)
      WIG9X = RVALUE
      END ;
   %%SUBNAME  CFACRC %
   PROCESS    NO LIST      MAP    HEADER  %SUBNAME
   FUNCTION   %SUBNAME (WFL,WFR,NREL,LST,LRT)
      IMPLICIT REAL*8(A-H,O-Z)
      EXTERNAL IOR,ISP,CFP
      %comwfa
      INTEGER * 4  WSL,WRL,WSR,WRR
      REAL    * 8  ZP,XCFAC,%SUBNAME
      INTEGER * 4  WFL,WFR,LST,LRT
      INTEGER * 4  DEBUG ; DATA DEBUG/0/
      ZP( IH )  = 1.0D0 - 2.0D0*(MOD( (IH+8888)/2, 2 ) )
   BEGIN
      XCFAC= 0.0D0
      LRO = ILFO( WFL ) ; L = LRO/2 + 1 ;
      LSO = 2 ; / DOUBLET /
      WSL = ISP( WFL ) ; WRL = IOR( WFL ) ;
      WSR = ISP( WFR ) ; WRR = IOR( WFR ) ;
       K =  TOPADR( L ) + NREL - 1
       FOR I = WFADR( K ), WFADR( K ) + NSHL( K ) - 1 ;
       DO ;
          XCFAC= XCFAC--
            + WIG6J( LSO, LST, LSO, WSL, WS(I), WSR )  --
            * WIG6J( LRO, LRT, LRO, WRL, WR(I), WRR )  --
            * CFP  ( WFL, WF( I ), NREL - 1,1)         --
            * CFP  ( WF(I), WFR,   NREL   ,-1)
          END
       XCFAC=   XCFAC--
              * DSQRT( DFLOAT ( LST * LRT ) )  --
              * ZP( LST + LRT + WSL + WRL + WSR + WRR - 4 )
       %SUBNAME = XCFAC
      END ;
