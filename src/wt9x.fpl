     PROCEDURE OPERATOR_SET_RCPL_23
        /* --H1--H2--H3--H4--
        /*   XX
        M = NL(1)   ; MODE(M)= MD(1) ; NOP(M)= 4 ;
        HSX(M) = %D ; HRX(M) = HL(1) ;
        HSC(M) = %D ; HRC(M) = HL(1) ;
        /* --H1--H2--H3--H4--
        /*     XX
        DO FOR M = NL(1)+1, NL(2) - 1 ;
           HSC(M) = HSC(M-1) ; HRC(M)=HRC(M-1) ; NOP(M) = 3 ;
           HSX(M) = %S       ; HRX(M)= %S      ; MODE(M) = %I
           END
        M = NL(3)   ; MODE(M)= MD(3) ; NOP(M)= 2 ;
        HSC(M) = %D ; HRC(M) = HL(4) ;
        /* --H1--H2--H3--H4--
        /*             XX
        DO FOR M = NL(3)+1, NL(4) - 1 ;
           HSC(M) = HSC(M-1) ; HRC(M)=HRC(M-1) ; NOP(M) = 1 ;
           HSX(M) = %S       ; HRX(M)= %S      ; MODE(M) = %I
           END ;
        /* --H1--H2--H3--H4--
        /*               XX
        M = NL(4)   ; MODE(M)= MD(4) ; NOP(M)= 1 ;
        HSX(M) = %D ; HRX(M) = HL(4) ;
        HSC(M) = %S ; HRC(M) = %S    ;
        DO FOR M = NL(4)+1, NHT ;
           HSC(M) = HSC(M-1) ; HRC(M)=HRC(M-1) ; NOP(M) = 0 ;
           HSX(M) = %S       ; HRX(M)= %S      ; MODE(M) = %I
           END ;
        %NOT
        EXEC FIND_MID_STATE
        WT = 0.0D0
        IF KSTACT = 0 THEN EXIT
        WHILE KSTACT >= 2  ;
        DO ;
           LSM = %UK   ; LRM = %UK ;
           IF MP
           THEN ET = %RCPLZZ
           ELSE ET = %RCPLXX
           IF DABS(ET) < SLES THEN EXIT
           /* --H1--H2--H3--H4--
           /*       XX
           M = NL(2)   ; MODE(M)= MD(2) ; NOP(M)= 3 ;
           HSX(M) = %D ; HRX(M) = HL(2) ;
           HSC(M) = LSM; HRC(M) = LRM   ;
           /* --H1--H2--H3--H4--
           /*         XX
           DO FOR M = NL(2)+1, NL(3) - 1 ;
              HSC(M) = HSC(M-1) ; HRC(M)=HRC(M-1) ; NOP(M) = 2 ;
              HSX(M) = %S       ; HRX(M)= %S      ; MODE(M) = %I
              END ;
           /* --H1--H2--H3--H4--
           /*           XX
           M = NL(3)   ; MODE(M)= MD(3) ; NOP(M)= 2 ;
           HSX(M) = %D ; HRX(M) = HL(3) ;
           HSC(M) = %D ; HRC(M) = HL(4) ;
           MI = NL(1)  ; ME = NHT       ; EXEC FACTORIZATION ;
           WT = WT + W * ET ; /* ET IS RECOUPLING COEFFICIENT
           W  = 0.0D0
           END ;
        W = WT ;
        END ;
     PROCEDURE OPERATOR_SET_RCPL_C23
        /* --H1--(H2H3)--H4--
        /*   XX
        M = NL(1)   ; MODE(M)= MD(1) ; NOP(M)= 4 ;
        HSX(M) = %D ; HRX(M) = HL(1) ;
        HSC(M) = %D ; HRC(M) = HL(1) ;
        /* --H1--(H2H3)--H4--
        /*     XX
        DO FOR M = NL(1)+1, NL(2) - 1 ;
           HSC(M) = HSC(M-1) ; HRC(M)=HRC(M-1) ; NOP(M) = 3 ;
           HSX(M) = %S       ; HRX(M)= %S      ; MODE(M) = %I
           END
        /* --H1--(H2H3)--H4--
        /*         XX
        M = NL(2)   ; MODE(M)= MD(2) ; NOP(M)= 3 ;
        HSC(M) = %D ; HRC(M) = HL(4) ;
        /* --H1--(H2H3)--H4--
        /*             XX
        DO FOR M = NL(3)+1, NL(4) - 1 ;
           HSC(M) = HSC(M-1) ; HRC(M)=HRC(M-1) ; NOP(M) = 1 ;
           HSX(M) = %S       ; HRX(M)= %S      ; MODE(M) = %I
           END ;
        /* --H1--(H2H3)--H4--
        /*               XX
        M = NL(4)   ; MODE(M)= MD(4) ; NOP(M)= 1 ;
        HSX(M) = %D ; HRX(M) = HL(4) ;
        HSC(M) = %S ; HRC(M) = %S    ;
        DO FOR M = NL(4)+1, NHT ;
           HSC(M) = HSC(M-1) ; HRC(M)=HRC(M-1) ; NOP(M) = 0 ;
           HSX(M) = %S       ; HRX(M)= %S      ; MODE(M) = %I
           END ;
        IF MD(2) =%CAXX ! MD(2) =%XXCA
        THEN DO ;
           M = NL(2)   ; MODE(M)= MD(2) ; NOP(M)= 3 ;
           HSX(M) = LSI; HRX(M) = LRI   ;
           HSC(M) = %D ; HRC(M) = HL(4) ;
           MI = NL(1)  ; ME = NHT       ; EXEC FACTORIZATION ;
           END ;
        ELSE DO ;
           EXEC FIND_OPERATOR_COUPLING_23
           IF KSTACT = 0 THEN EXIT
           WT = 0.0D0
           WHILE KSTACT >= 2  ;
           DO ;
              LSM = %UK  ; LRM =%UK ;
              ET = %RCPLYY
              IF DABS(ET) < SLES THEN EXIT
              /* --H1--(H2H3)--H4--
              /*         XX
              M = NL(2)   ; MODE(M)= MD(2) ; NOP(M)= 3 ;
              HSX(M) = LSM; HRX(M) = LRM   ;
              HSC(M) = %D ; HRC(M) = HL(4) ;
              MI = NL(1)  ; ME = NHT       ; EXEC FACTORIZATION ;
              WT = WT + W * ET ; /* ET IS RECOUPLING COEFFICIENT
              W  = 0.0D0
              END ;
           W = WT ;
           END ;
        END ;
  PROCEDURE  FIND_OPERATOR_COUPLING_23

  /* # OF SHELL    = 1
  /* # OF OPERATOR = 2
     NSH = NL(2) ;
  /* TRIANGLE CONDITION  HL(2) AND HL(3)
     MAXOS1 = 3                    ; MINOS1 = 1 ;
     MAXOR1 = HL(3) +  HL(2) - 1   ; MINOR1 = 1 ;
  /* TRIANGLE CONDITION  FSX, HSX, GSX
     MAXOS2= MAXS (FSX(NSH) ,GSX(NSH)) ;
     MINOS2= MINS (FSX(NSH) ,GSX(NSH)) ;
     MAXOR2= MAXS (FRX(NSH) ,GRX(NSH)) ;
     MINOR2= MINS (FRX(NSH) ,GRX(NSH)) ;
  /* TRIANGLE CONDITION  FSX(NSH-1), HSX, FSX(NSH)
     MAXOS3= MAXS (FSX(NSH-1) ,FSX(NSH)) ;
     MINOS3= MINS (FSX(NSH-1) ,FSX(NSH)) ;
     MAXOR3= MAXS (FRX(NSH-1) ,FRX(NSH)) ;
     MINOR3= MINS (FRX(NSH-1) ,FRX(NSH)) ;
  /* OPERATOR COUPLING FOR SPIN
     MAXOPS= MAX0( MAXOS1, MAXOS2, MAXOS3 ) ;
     MINOPS= MIN0( MINOS1, MINOS2, MINOS3 ) ;
     IF MAXOPS < MINOPS THEN EXIT
     MAXOPR= MAX0( MAXOR1, MAXOR2, MAXOR3 ) ;
     MINOPR= MIN0( MINOR1, MINOR2, MINOR3 ) ;
     IF MAXOPR < MINOPR THEN EXIT
     /* FIND PAIR FOR HL(2)
     FOR NSPIN =     1,     3,  2
     FOR NORB = MINOPR, MAXOPR, 2
     DO ;
        %SK = NORB      ; %SK = NSPIN   ;
        END
     END

 /* XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
     PROCEDURE OPERATOR_SET_1EL
        IF LSI ^= 1 & LSI ^= 3  THEN EXIT W = 0.0D0
        IF MAXS( HL(1), HL(2) ) < LRT ! --
           MINS( HL(1), HL(2) ) > LRT THEN EXIT  W = 0.0D0
        /* --H1--H2--
        /* XX
        HSC(0) = %S ; HRC(0) = %S;
        DO FOR M = 1, NL(1) -1 ;
           HSC(M) = HSC(M-1) ; HRC(M)=HRC(M-1) ; NOP(M) = 2 ;
           HSX(M) = %S       ; HRX(M)= %S      ; MODE(M) = %I
           END
        /* --H1--H2--
        /*   XX
        M = NL(1)   ; MODE(M)= MD(1) ; NOP(M)= 2 ;
        HSX(M) = %D ; HRX(M) = HL(1) ;
        HSC(M) = %D ; HRC(M) = HL(1) ;
        /* --H1--H2--
        /*   XX
        DO FOR M = NL(1)+1, NL(2) - 1 ;
           HSC(M) = HSC(M-1) ; HRC(M)=HRC(M-1) ; NOP(M) = 1 ;
           HSX(M) = %S       ; HRX(M)= %S      ; MODE(M) = %I
           END
        /* --H1--H2--
        /*       XX
        M = NL(2)   ; MODE(M)= MD(2) ; NOP(M)= 1 ;
        HSX(M) = %D ; HRX(M) = HL(2) ;
        HSC(M) = LST; HRC(M) = LRT   ;
        /* --H1--H2--
        /*         XX
        DO FOR M = NL(2)+1, NHT ;
           HSC(M) = HSC(M-1) ; HRC(M)=HRC(M-1) ; NOP(M) = 0 ;
           HSX(M) = %S       ; HRX(M)= %S      ; MODE(M) = %I
           END ;
        MI = NL(1) ; ME = NHT   ; EXEC FACTORIZATION ;
        END ;

     PROCEDURE OPERATOR_SET_1EL_C12
        DO CASE OF LST
           1 : IF MOD( LRT, 4 ) = 1 THEN EXFLG = 0 ; ELSE EXFLG = 1
           3 : IF MOD( LRT, 4 ) = 3 THEN EXFLG = 0 ; ELSE EXFLG = 1
           OTHERWISE   EXFLG = 1
        IF EXFLG = 1 THEN EXIT W = 0.0D0
        /* --(H1H2)--
        /* XX
        HSC(0) = %S ; HRC(0) = %S;
        DO FOR M = 1, NL(1) -1 ;
           HSC(M) = HSC(M-1) ; HRC(M)=HRC(M-1) ; NOP(M) = 2 ;
           HSX(M) = %S       ; HRX(M)= %S      ; MODE(M) = %I
           END
        /* --(H1H2)--
        /*     XX
        M = NL(1)   ; MODE(M)= MD(1) ; NOP(M)= 2 ;
        HSX(M) = LST; HRX(M) = LRT   ;
        HSC(M) = LST; HRC(M) = LRT   ;
        /* --(H1H2)--
        /*         XX
        DO FOR M = NL(2)+1, NHT
           HSC(M) = HSC(M-1) ; HRC(M)=HRC(M-1) ; NOP(M) = 0 ;
           HSX(M) = %S       ; HRX(M)= %S      ; MODE(M) = %I
           END ;
        MI = NL(1) ; ME = NHT   ; EXEC FACTORIZATION ;
        END ;
