   PROCESS       FILE      'citr.f'
   %%SUBNAME  TRMAIN%
   PROCESS   NO  LIST      MAP    HEADER  %SUBNAME
      SUBROUTINE %SUBNAME (TITLE, FILES, METHOD, USCPU,  RTNCD)
  %CPYRIGHT
  %UPDATE
  /   MODIFIED BY M.S.  01/12/1987   AT IMS
  /   MODIFIED BY TASHI 10/24/1989   AT TASHI
  /*
  /*     FUNCTION :  TRANSFORMATION
  /*
  /*     CALLED   : ATOMCI
  /*     CALLING  : TRDRIV
  /*
  /*     INPUT    : NAMELIST  INTRN   & NFAII  ( UNIT = 18 AS NORMALLY )
  /*                & NFTRN ( UNIT = 27 )
  /*     RETURNS  : FILE NFTRI( UNIT = 16 AS NORMALLY ) > TR INTEG
  /*                FILE NFTRN( UNIT = 27 AS NORMALLY ) > NO FILES
  /*                FILE NFTRC( UNIT = 21 AS NORMALLY ) > TR COEF
  /*
  IMPLICIT INTEGER   * 4 (A-Z)
  %INCMAIN
  %INCMACRO
  %INCWORK
  %param
      INTEGER   * 4 VAR(%WORKCORE)
      common/work/var
   /*
   /* DCL FOR LOCAL VAR
   /*
   INTEGER   * 4  ISTART,      -- ADDR FOR  WORK REGION
                  NAME(33),    -- COMMENT ON NFTB
                  NPFLG;  

   INTEGER   * 4 NBF(20),NPBF(%BASIS),MBF(%BASIS),  -- BASIS FUNCTION
                 NOB(20),MPOB(%BASIS)    -- ORBITAL INFORMATION

   DATA           NPFLG   / 0/-- DEBUG FLAG

   %INCDATA

  %%NAMELIST TR %
  /* NAMELIST ITEM
  NAMELIST /%NAMELIST/ --                    STATUS  DEFAULT DIM TYPE
            NFTRN,   -- NO TAPE              ?????       27       I4
            NFTRC,   -- TR COEF  : RETURN    OUTPUT      21       I4
            NFAII,    -- COMMENT ON NFTB      INPUT       18       I4
            NFAIX,   --                      ?????       19       I4
            NFTRI,   -- TR INTEG             OUTPUT      16       I4
            NFTRX,   -- TR INTEG             ?????       17       I4
            NFTRD,    -- TR WORK FILE DA      WORK        20       I4
            LTRB1,   --                                NONE       I4
            NPFLG,   -- PRINT FLAG                        0       I4
            NAME,    -- COMMENT                        NONE    33*I4
            NFLGS,   --                                   1       I4
            NSYM,    -- # OF SYMMETRY                  NONE       I4
            NOB,     -- # OF ORBITALS IN EACH SYM      NONE   150*I4
            NBF,     -- # OF BASIS IN EACH SYM         NONE   150*I4
            IORDR,   -- ONLY USING 0/DUMMY                0       I4
            MAXM,    --                                           I4
            NBFT,    --                                           I4
            NPBF,    --                                           I4
            MBF,     --                                           I4
            LTRA1B,  --                                           I4
            LTRB,    --                                           I4
            ITVCI,   --                                   1       I4
            NCODT,   --                                   1       I4
            NCODC,   --                                   1       I4
            MPOB,    --                                NONE       I4
            ITRNS,   --   0: NO TRNS                      2       I4
                     --   1: COPY NFTRI(B1) -> NFTRX(B2)
                     --   2: NORMAL TRANSFORMATION
            LDSK     --                                2000       I4

   BEGIN
      ERRCD =0 ; RTNCD = 0 ;
      %START

      EXEC WORK_REGION
      IF ERRCD > 0 THEN EXIT %FINISH
      NRDFG = METHOD(30)
      IF NRDFG > 0 THEN DO
         EXEC SETUP
         FOR  I= 1,18 ; NAME(I) = TITLE(I)
         FOR  I=19,33 ; call ctoi4 ( '    ', NAME(I) )
         FORTRAN READ(5,%NAMELIST,END=900)
         END
      EXEC PRINT_HEADER
      FOR  I=9,12 ; NAME(I+18) = METHOD(I)
      EXEC DATA_CHECK

      CALL TRDRIV(VAR(ISTART),VAR(ISTART),WKSIZE,  -- CORE REGION AND CORE
                  NRDFG,            --
                  NFTRN,NFTRC,NFAII,NFAIX,NFTRI,NFTRX,NFTRD, --
                  LTRB1,NPFLG,NAME,NFLGS,NSYM,NOB,    --
                  MAXM,NBFT,NBF,NPBF,MBF,LTRA1B,NCODT,       --
                  LTRB,ITVCI,NCODC,MPOB,               --
                  ITRNS,LDSK,ERRCD)
      EXIT %FINISH

      FORTRAN 900 CONTINUE
      FORMAT WRITE --
       '    NAMELIST - &%NAMELIST - NOT FOUND IN INPUT DATA  '
      (/' ',A,20('*')////)
      ERRCD = 4000
      %FINISH
      END

  > PRINT_HEADER
     FORMAT WRITE (TITLE(I),I=1,18),(NAME(I), I=1,18),  --
         METHOD(41) , NFAII , METHOD(46) , NFTRI , --
         METHOD(48) , NFTRN , --
         METHOD(49) , NFTRC , METHOD(50) , NFTRD , --
           ITRNS,  LDSK,FILES,NPFLG
     ('1',45('*'),3X,'TRANSFORMATION(%SUBNAME)'/      --
        /' TITLE :  ',18A4 /                                   --
        /' NAME  :  ',18A4 /                                   --
        /'  NFAII :  AO BASIS INTEGRAL       (',I3,') =',I6, --
        /'  NFTRI :  TRANSFORMED INTEGRAL    (',I3,') =',I6, --
        /'  NFTRN : PERMANENT TR COEFFICIENTS(',I3,') =',I6, --
        /'  NFTRC : TEMPORARY TR COEFFICIENTS(',I3,') =',I6, --
        /'  NFTRD :  WORK FILE ( DIRECT )    (',I3,') =',I6, --
      ///'  ITRNS :  TRANSFORMATION RUN FLAG       =',I6,         --
        /'  LDSK  :  NUMBER OF BLOCKS IN DA FILE   =',I6,         --
        /'  SUMMARY FILES UNIT = ',I3,'      PRINT FLAG = ',I3/)
     END


      PROCEDURE WORK_REGION
         ACTION = %REGION
         %%VNAME WKSIZE% ; TYPE = %I4 ; %WKCORE
         ACTION = %ALLOC
         %%VNAME ISTART% ; TYPE = %R8 ; LENGTH = WKSIZE/2 ; %WKCORE
         END
      PROCEDURE DATA_CHECK
         IF NFAII ^= METHOD(41)
         THEN DO ; / CHECK
            IF METHOD(23) = 0 THEN METHOD(41) = NFAII
            ELSE DO
               1L ; ' * WARNING *  EMERGENCY STOP !! ' ;
                    '  BECAUSE AO INTEGRAL FILE UNIT MAY NOT BE ' ;
                       PUT NFAII I4 ; 1L
                    ' * WARNING * PLEASE CHECK FILE UNIT OR DDNAME '
               ERRCD = 4001 ;   2L ;
               END
            END
         METHOD(42) = NFAIX ; METHOD(46) = NFTRI
         METHOD(47) = NFTRX ; METHOD(48) = NFTRN
         METHOD(49) = NFTRC ; METHOD(50) = NFTRD
         END
      PROCEDURE SETUP
         NFAII = METHOD(41) ; NFAIX = METHOD(42) ;
         NFTRN = METHOD(48) ; NFTRC = METHOD(49) ;
         NFTRI = METHOD(46) ; NFTRX = METHOD(47) ;
         NFTRD = METHOD(50)
         ITRNS = 2 ; ITVCI = 1 ; NPFLG = 0 ; NCODC = 1 ;
         NFLGS = 1 ; NCODT = 1 ; LDSK = 2000 ; NBFT = 0 ; MPOB(1) = 0
         LTRA1B = 7200 ; LTRB = 449 ; LTRB1 = 448 ;
         END
     %INCWKEXC
