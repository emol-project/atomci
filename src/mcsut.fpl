 process no list file 'mcsut.f'
 %%subname rdvec%
 %param
 %%debug  % 
 subroutine %subname --
	    ( ivcs,nsym,  nob, nind, ind,  --
	      nbf, c, last, w,rtncd ) ; 
    implicit integer ( a-z )
    real * 8    c(*),w(*)
    integer * 4 NBF(%llimit),NOB(%llimit) ; /* input
    integer * 4 mbf(20),mob(20),nread(20),name(20)
    integer * 4 nind,ind(4,100) 
    logical     ends,errs
    %charorb

    begin 
       rtncd = 0 ; nread(1) = 1
       for i = 2, nsym ; nread(i) = nread(i-1)  + nbf(i-1)*nob(i-1); 
       rsym = 0 ; rset= 0 ;  /* pointer of records 
       ix= 0 ; sym = 0 ; msym = 0 ;  
       until (ix=nind!rtncd > 0 )
       do 
          ix= ix+ 1 ;
          set = ind(1,ix) ; sym= ind(2,ix)+1 ; 
	  n1  = ind(3,ix) ; n2 = ind(4,ix) ;
	  nx= ( n2 - n1 + 1 ) * nbf(sym)
	  format write ivcs,set, n1, lsym(sym),  n2, lsym(sym) 
	  (' Read from ',i4,' set ',i4,i8,a1,' to',i4,a1) 
	  if set = 0 then exit exec clear
	  if set ^= rset  then exec head 
          if rsym ^= sym then exec w_read  
          exec copy
	  end 
       end 
> head
   rewind ivcs ;
   call tell(0) 
   rsym = 0  
   call find(set,ivcs) ;
   rset = set 
   binary read:ivcs -- 
     errflag = errs endflag = ends iostat = iostat -- 
     name, n, msym, mbf, mob
   /* check */
   if errs ! ends then exit rtncd = 12002 ;  
   if mbf(sym) ^= nbf(sym) then exit rtncd = 12101  
   end
> w_read
   if rsym < sym then --  
   for j = 1, sym - rsym - 1 ; 
   binary read:ivcs -- 
	     errflag = errs endflag = ends iostat = iostat dumy
   else if rsym > sym then --
   for j = 1, rsym - sym + 1; backspace ivcs 
   np = mbf(sym) * mob(sym) 
   binary read:ivcs -- 
	     errflag = errs endflag = ends iostat = iostat -- 
	     dumy,( w(j), j= 1,np )
 /* debug   call prvc(w,mbf(sym),mob(sym)) 
   if dumy ^= sym-1 then exit rtncd = 12003 ; 
   rsym = sym 
   end 
 > copy
   nskip = nread(sym) ; nw = ( n1 - 1 ) * nbf(sym) + 1
   call xmove(c(nskip),w(nw),nx) 
   nread(sym) = nread(sym) + nx ; 
   end
 > clear
   nskip = nread(sym) ; 
   for i = 1, nx ; w(i) = 0.d0
   call xmove(c(nskip),w(1),nx) 
   nread(sym) = nread(sym) + nx ; 
   end
 %%subname wtvec%
 subroutine %subname --
	    ( ivcs,nsym,  nob, nind, ind,  --
	      nbf, c, nset, name, rtncd ) ; 
    implicit integer ( a-z )
    real * 8    c(*)
    integer * 4 NBF(%llimit),NOB(%llimit) ; /* input
    integer * 4 nind,ind(4,100) 
    /* character * 80 name  changed by mas 03/24/95
    integer * 4 name(20)
    logical     errs
    begin 
       rewind ivcs
       call tell(0)
       call find(nset,ivcs)
       binary write:ivcs errflag = errs  --
               name, nset, nsym, nbf, nob, nind, --
               ((ind(j,i),j=1,4),i=1,nind)
       if errs then exit rtncd = 13001
       ii = 1 ; ij = 0
       for i = 0, nsym-1 ;
       do 
	 ij  = ij + nbf(i+1)*nob(i+1)
         binary write:ivcs i,(c(j),j=ii,ij)
	 ii = ij + 1
	 end 
       endfile ivcs
       format write ivcs, nset
       (// ' Output vectors stored in file',i3,--
	   '  at record',i5 )
       end 
