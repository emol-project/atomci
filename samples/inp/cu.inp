# Cu 3d10 4s 2S -- samples/native/cu.stdin and cu.atg as an .inp: cc-pVTZ,
# SCF of the 3d10 4s configuration, SD-CI of the 4s and 3d electrons with
# 1s 2s 2p 3s 3p frozen. Needs cu.bas (next to this file) in the work
# directory.
# Answer: MCSCF -1638.96192568, SD-CI = -1639.376374

title:  " CU DOUBLET S "
deck:   cu.deck
csf:    cu.csf

atom:
  z:     29
  ang:   S
  spin:  2

files:
  cfptable:  ./CFPTBL
  basis:     cu.bas
  open:
    - unit: 27, file: cu.NO, format: binary, status: unknown

orbital:
  frozen_core:  1S, 2S, 2P, 3S, 3P
  active:       4S, 3D
  outer:        3S, 4P, 3D, 2F, 1G

reference:
  - scf: true, occ: 4S*1 3D*10

ctrl:
  ai:  type: 2, idprnt: 0
  mc:  itmax: 30
  wf:  rule: 1, npflg: 0
  tr:  from_record: 1
  ci:  ips: 7, maxit: 100, nsdim: 100, nstate: 1
  rs:  print: -0.001
