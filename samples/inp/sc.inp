# Sc 3d 4s2 2D -- samples/native/sc.stdin and sc.atg as an .inp: cc-pVTZ,
# SCF of the 3d 4s2 configuration, SD-CI of the 4s and 3d electrons with
# 1s 2s 2p 3s 3p frozen. Needs sc.bas (next to this file) in the work
# directory.
# Answer: MCSCF -759.73544953, SD-CI = -759.776305

title:  " SC DOUBLET D "
deck:   sc.deck
csf:    sc.csf

atom:
  z:     21
  ang:   D
  spin:  2

files:
  cfptable:  ./CFPTBL
  basis:     sc.bas
  format:    atomci
  open:
    - unit: 27, file: sc.NO, format: binary, status: unknown

orbital:
  frozen_core:  1S, 2S, 2P, 3S, 3P
  active:       4S, 3D
  outer:        3S, 4P, 3D, 2F, 1G

reference:
  - scf: true, occ: 4S*2 3D*1

ctrl:
  ai:  type: 2, idprnt: 0
  mc:  itmax: 30
  wf:  rule: 1, npflg: 0
  tr:
    ind:
      - record: 1, l: 0, first: 1, last: 7
      - record: 1, l: 1, first: 1, last: 6
      - record: 1, l: 2, first: 1, last: 4
      - record: 1, l: 3, first: 1, last: 2
      - record: 1, l: 4, first: 1, last: 1
  ci:  ips: 7, maxit: 100, nsdim: 100, nstate: 1
  rs:  print: -0.001
