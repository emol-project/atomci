# F 2s2 2p5 2P (odd) -- samples/native/fpt.stdin as an .inp: SD-CI with
# perturbative selection of the CSFs (&WF RULE=2), on the natural orbitals
# of the first pass of f.inp (record 2 of f.NO). Run f.inp first, in the
# same directory.
# Answer: SD-CI = -99.640355

title:  " F DOUBLET P (NO 1) "
deck:   fpt.deck
csf:    fpt.csf

atom:
  z:     9
  ang:   P
  spin:  2

files:
  cfptable:  ./CFPTBL
  basis:     f.bas
  open:
    - unit: 27, file: f.NO, format: binary, status: old

orbital:
  frozen_core:  1S
  active:       2S, 2P
  outer:        11S, 10P, 6D, 5F

reference:
  - scf: true, occ: 2S*2 2P*5

ctrl:
  ai:  type: 2, idprnt: 0
  wf:  rule: 2, npflg: 0
  tr:  from_record: 2
  pt:  nstate: 1, istate: 1, ethr: 0.001, cthr: 0.01, how: 0, nrnfg: 1 1 1
  ex:  retry: false
  ci:  ips: 7, maxit: 100, nsdim: 100, nstate: 1
  rs:  print: -0.001, rule: 2, nrnfg: 1
