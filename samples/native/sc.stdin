OPEN UNIT=10 FILE=./CFPTBL BINARY STATUS=OLD
OPEN UNIT=27 FILE=sc.NO BINARY
OPEN UNIT=2 FILE=sc.csf STATUS=OLD
OPEN UNIT=3 FILE=sc.bas STATUS=OLD
OPEN UNIT=7 FILE=sc.time
END
"
"  Sc 3d 4s2 2D: MCSCF (one CSF) orbitals in cc-pVTZ, then SD-CI of the
"  three valence electrons (1s 2s 2p 3s 3p frozen)
"
 &CNTL NRNFG=1,1,1,1,0,0,1,1, TITLE=' SC DOUBLET D ', /
 &AI IUNIT=3, Z=21.0D0, NTYPE=2, IDPRNT=0, /
 &MC ITNEL=21, ISPIN=2, IORB=5, IPAR=0, NSET=1, ITMAX=30,
     CLOSED='  1S 2S 2P 3S 3P )',
     CSFS=' 4S*2) 3D*1 ))',
          ' )))', /
 &WF ITNEL=21, ISPIN=2, IORB=5, IPAR=0, RULE=1, NPFLG=0, IUNIT=2, /
 &TR NSYM=5, NBF=7,6,4,2,1, NOB=7,6,4,2,1,
     MPOB=7,6,5,4,3,2,1,
          6,5,4,3,2,1,
          4,3,2,1,
          2,1,
          1,   ITVCI=1, /
 &GET IVCS=27, NIND=5,
      IND= 1,0,1,7, 1,1,1,6, 1,2,1,4, 1,3,1,2, 1,4,1,1,
           /
 &CI NSTATE=1, NSDIM=100, IPS=7, NRNFG=1,1,1,0,1,1,
     MAXIT=100, IOFLG=0,-1,-1,0,0, /
 &RS RULE=2, PTHR=-0.001, NRNFG=0, /
