OPEN UNIT=10 FILE=./CFPTBL BINARY STATUS=OLD
OPEN UNIT=27 FILE=be.NO BINARY
OPEN UNIT=2 FILE=be.csf STATUS=OLD
OPEN UNIT=3 FILE=be.bas STATUS=OLD
OPEN UNIT=7 FILE=be.time
END
"
"  Be 2s2 1S: MCSCF of the two configurations 2s2 and 2p2 in cc-pVTZ,
"  then SD-CI from both references (1s frozen)
"
 &CNTL NRNFG=1,1,1,1,0,0,1,1, TITLE=' BE SINGLET S, MRSDCI ', /
 &AI IUNIT=3, Z=4.0D0, NTYPE=2, IDPRNT=0, /
 &MC ITNEL=4, ISPIN=1, IORB=1, IPAR=0, NSET=1, ITMAX=30,
     CLOSED='  1S )',
     CSFS=' 2S*2) 2P*0 ))',
          ' 2S*0) 2P*2 ))',
          ' )))', /
 &WF ITNEL=4, ISPIN=1, IORB=1, IPAR=0, RULE=1, NPFLG=0, IUNIT=2, /
 &TR NSYM=4, NBF=4,3,2,1, NOB=4,3,2,1,
     MPOB=4,3,2,1,
          3,2,1,
          2,1,
          1,   ITVCI=1, /
 &GET IVCS=27, NIND=4,
      IND= 1,0,1,4, 1,1,1,3, 1,2,1,2, 1,3,1,1,
           /
 &CI NSTATE=1, NSDIM=100, IPS=7, NRNFG=1,1,1,0,1,1,
     MAXIT=100, IOFLG=0,-1,-1,0,0, /
 &RS RULE=2, PTHR=-0.001, NRNFG=0, /
