<?xml version="1.0"?>
<!-- High-level ATOMCI input for msekiya.jar's deck generator.
     F (fluorine) doublet-P, second-order perturbative selection (&PT)
     on the natural orbitals produced by the f.xml run (unit 27 = f.NO).
     No MCSCF step (uses the natural orbitals directly).
     Verified: the generated deck + CSF run through atomci to the
     golden PT-selected SD-CI energy  -99.640355.

     PREREQUISITE: run f.xml first and keep its f.NO in the work dir.
     See README.md in this directory. -->
<atomciInput>
  <info title=" F DOUBLET P (NO 1) " output="fpt.deck">
    <atom ang="P" spin="2" z="9"/>
    <cfptable file="./CFPTBL"/>
    <csf file="fpt.csf" status="unknown"/>
    <basis file="f.bas" format="atomci" status="old"/>
    <mcp file="mcp.dat"/>
    <open unit="27" file="f.NO" format="binary" status="old"/>
  </info>
  <orbital>
    <frozen_core n="1" l="0"/>
    <active id="2S"/><active id="2P"/>
    <outer n="11" l="0"/><outer n="10" l="1"/><outer n="6" l="2"/><outer n="5" l="3"/>
  </orbital>
  <reference><conf scf="true"><orb id="2S" occ="2"/><orb id="2P" occ="5"/></conf></reference>
  <ctrl>
    <ai type="2" idprnt="0"/>
    <wf rule="2" npflg="0"/>
    <tr record="1">
      <ind record="2" l="0" first="1" last="2"/>
      <ind record="2" l="0" first="3" last="13"/>
      <ind record="2" l="1" first="1" last="1"/>
      <ind record="2" l="1" first="2" last="11"/>
      <ind record="2" l="2" first="1" last="6"/>
      <ind record="2" l="3" first="1" last="5"/>
    </tr>
    <pt cthr="0.01" ethr="0.001" how="0" nstate="1"/>
    <ex retry="false"/>
    <ci ips="7" maxit="100" nsdim="100" nstate="1"/>
    <rs print="-0.001"/>
  </ctrl>
</atomciInput>
